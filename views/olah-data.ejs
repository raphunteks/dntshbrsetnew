                </div>

                <!-- 2-COL: JUDUL PENELITIAN & METODE ANALISIS -->
                <div class="olah-form-2col" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 0.5rem;">
                  <div class="form-group" style="margin: 0;">
                    <label class="form-label" style="font-weight: 600; font-size: 0.85rem;">
                      Judul penelitian <span style="color: var(--text-muted); font-weight: normal;">(opsional)</span>
                    </label>
                    <input type="text" name="research_title" class="form-control" placeholder="mis. Representasi Gender dalam Iklan X" value="<%= (locals.input && input.research_title) ? input.research_title : '' %>">
                  </div>

                  <div class="form-group" style="margin: 0;">
                    <label class="form-label" style="font-weight: 600; font-size: 0.85rem;">Metode analisis</label>
                    <select name="analysis_method" class="form-control">
                      <option value="Semiotika (Barthes/Peirce)">Semiotika (Barthes/Peirce)</option>
                      <option value="Mise-en-scène (Cinematography)">Mise-en-scène (Cinematography)</option>
                      <option value="Analisis Visual Multimodal (Kress & van Leeuwen)">Analisis Visual Multimodal (Kress &amp; van Leeuwen)</option>
                    </select>
                  </div>
                </div>

                <p style="font-size: 0.775rem; color: var(--text-muted); margin: 0 0 1.25rem;">
                  Penanda&ndash;petanda, denotasi&ndash;konotasi, mitos — cocok untuk iklan &amp; film.
                </p>

                <!-- FOKUS / RUMUSAN MASALAH -->
                <div class="form-group" style="margin-bottom: 1.25rem;">
                  <label class="form-label" style="font-weight: 600; font-size: 0.85rem;">
                    Fokus / rumusan masalah <span style="color: var(--text-muted); font-weight: normal;">(opsional)</span>
                  </label>
                  <textarea name="focus_problem" class="form-control" rows="3" placeholder="mis. Bagaimana perempuan direpresentasikan secara visual...?"><%= (locals.input && input.focus_problem) ? input.focus_problem : '' %></textarea>
                </div>

                <!-- FILE VIDEO PICKER -->
                <div class="form-group" style="margin-bottom: 1.5rem;">
                  <label class="form-label" style="font-weight: 600; font-size: 0.85rem;">File video</label>
                  <div class="olah-file-picker-wrap">
                    <label class="olah-file-picker-btn">
                      Pilih File
                      <input type="file" accept=".mp4, .mov, .mkv, .avi, .webm" onchange="handleFileSelected(this, 'visual_filename')">
                    </label>
                    <span class="olah-file-picker-name" id="visual_filename">Tidak ada file yang dipilih</span>
                  </div>
                  <input type="hidden" name="video_file_name" id="visual_filename_hidden" value="">
                  <p style="font-size: 0.775rem; color: var(--text-muted); margin: 0.35rem 0 0;">
                    MP4/MOV/MKV/AVI/WEBM · maks 1GB. Untuk hemat, potong ke bagian penting sebelum unggah.
                  </p>
                </div>

                <!-- TOMBOL AKSI -->
                <div>
                  <button type="submit" class="btn-emerald" id="btnSubmitVisual">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                    Mulai Analisis Visual
                  </button>
                </div>
              </form>
            </div>
          </div>

          <!-- ===================================================================
               WORKBENCH 1: TRANSKRIPSI AUDIO/VIDEO (PERSIS GBR 6)
               =================================================================== -->
          <div class="card olah-workbench-card" id="wb_transkrip" style="border: 1px solid var(--border-color); background: var(--bg-card); border-radius: var(--radius-lg); margin-bottom: 2rem; display: none;">
            <div class="card-body" style="padding: 1.75rem;">
              <div style="display: flex; align-items: flex-start; gap: 1rem; margin-bottom: 1.25rem;">
                <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(14, 165, 233, 0.15); color: #0284c7; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
                </div>
                <div>
                  <h3 style="font-size: 1.15rem; font-weight: 700; margin: 0 0 0.25rem; color: var(--text-main);">
                    Transkripsi Audio/Video — Otomatis &amp; Verbatim
                  </h3>
                  <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0;">
                    Unggah audio atau video wawancara &rarr; transkrip otomatis dengan label pembicara &amp; timestamp terverifikasi.
                  </p>
                </div>
              </div>

              <form action="/olah-data" method="POST" id="form_transkrip">
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                <input type="hidden" name="module_type" value="transkrip">

                <!-- 2-COL: JUDUL PENELITIAN & BAHASA -->
                <div class="olah-form-2col" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
                  <div class="form-group" style="margin: 0;">
                    <label class="form-label" style="font-weight: 600; font-size: 0.85rem;">
                      Judul penelitian <span style="color: var(--text-muted); font-weight: normal;">(opsional)</span>
                    </label>
                    <input type="text" name="research_title" class="form-control" placeholder="mis. Wawancara Mendalam Implementasi Kurikulum Merdeka" value="<%= (locals.input && input.research_title) ? input.research_title : '' %>">
                  </div>

                  <div class="form-group" style="margin: 0;">
                    <label class="form-label" style="font-weight: 600; font-size: 0.85rem;">Bahasa Audio</label>
                    <select name="audio_language" class="form-control">
                      <option value="Bahasa Indonesia Formal">Bahasa Indonesia Formal</option>
                      <option value="Bahasa Indonesia Campuran (Slang)">Bahasa Indonesia Campuran (Slang/Daerah)</option>
                      <option value="Bahasa Jawa / Sunda">Bahasa Daerah (Jawa / Sunda)</option>
                      <option value="English">English (Akademik)</option>
                    </select>
                  </div>
                </div>

                <!-- FILE AUDIO / VIDEO -->
                <div class="form-group" style="margin-bottom: 1.25rem;">
                  <label class="form-label" style="font-weight: 600; font-size: 0.85rem;">
                    File Rekaman Suara / Video (.mp3, .wav, .m4a, .mp4, .aac)
                  </label>
                  <div class="olah-file-picker-wrap">
                    <label class="olah-file-picker-btn">
                      Pilih File
                      <input type="file" accept=".mp3, .wav, .m4a, .mp4, .aac, .ogg" onchange="handleFileSelected(this, 'transkrip_filename')">
                    </label>
                    <span class="olah-file-picker-name" id="transkrip_filename">Tidak ada file yang dipilih</span>
                  </div>
                  <input type="hidden" name="file_name" id="transkrip_filename_hidden" value="">
                  <p style="font-size: 0.775rem; color: var(--text-muted); margin: 0.35rem 0 0;">
                    Maks 1GB per rekaman. Sistem mendeteksi jeda hening dan pergantian pembicara secara otomatis.
                  </p>
                </div>

                <!-- FOKUS WAWANCARA -->
                <div class="form-group" style="margin-bottom: 1.5rem;">
                  <label class="form-label" style="font-weight: 600; font-size: 0.85rem;">
                    Fokus Wawancara &amp; Kunci Terminologi <span style="color: var(--text-muted); font-weight: normal;">(opsional)</span>
                  </label>
                  <input type="text" name="focus_problem" class="form-control" placeholder="Contoh kata kunci teknis: pedagogik, diferensiasi, asesmen, modul ajar..." value="<%= (locals.input && input.focus_problem) ? input.focus_problem : '' %>">
                </div>

                <!-- TOMBOL AKSI -->
                <div>
                  <button type="submit" class="btn-emerald" id="btnSubmitTranskrip">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                    Mulai Transkripsi Audio/Video
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>

        <!-- HASIL PEMROSESAN OLAH DATA -->
        <% if (result) { %>
          <div style="margin-top: 2rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
              <h3 style="font-size: 1.3rem; font-weight: 700; color: var(--text-main); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0d9488" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 14 14"/></svg>
                <%= result.title || 'Hasil Analisis Terverifikasi' %>
              </h3>
              <button type="button" class="btn btn-secondary btn-sm" onclick="copyBab4Text(this)">
                Salin Narasi BAB IV
              </button>
            </div>

            <!-- JIKA MODUL SPSS (KUANTITATIF) -->
            <% if (result.module === 'spss') { %>
              <!-- DESCRIPTIVE STATISTICS -->
              <div class="card" style="margin-bottom: 1.5rem;">
                <div class="card-header" style="background: var(--bg-subtle);">
                  <h4 style="margin: 0; font-size: 0.95rem;">Tabel 1: Descriptive Statistics</h4>
                </div>
                <div class="card-body">
                  <div class="spss-table-container">
                    <table class="spss-math-table">
                      <thead>
                        <tr>
                          <th>Variabel</th>
                          <th>N</th>
                          <th>Mean</th>
                          <th>Std. Deviation</th>
                          <th>Minimum</th>
                          <th>Maximum</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% (result.descriptive_statistics || []).forEach(row => { %>
                          <tr>
                            <td><strong><%= row.variable %></strong></td>
                            <td><%= row.N %></td>
                            <td><%= row.mean.toFixed(2) %></td>
                            <td><%= row.std_dev.toFixed(2) %></td>
                            <td><%= row.min %></td>
                            <td><%= row.max %></td>
                          </tr>
                        <% }); %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>

              <!-- MODEL SUMMARY & ANOVA -->
              <div class="spss-tables-2col" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-bottom: 1.5rem;">
                <div class="card">
                  <div class="card-header" style="background: var(--bg-subtle);">
                    <h4 style="margin: 0; font-size: 0.95rem;">Tabel 2: Model Summary (Regresi)</h4>
                  </div>
                  <div class="card-body">
                    <% const ms = result.model_summary || {}; %>
                    <div style="display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.85rem;">
                      <div style="display: flex; justify-content: space-between;"><span>Koefisien Korelasi (R):</span> <strong><%= ms.R %></strong></div>
                      <div style="display: flex; justify-content: space-between;"><span>R Square (R²):</span> <strong style="color: #0d9488;"><%= ms.R_square %></strong></div>
                      <div style="display: flex; justify-content: space-between;"><span>Adjusted R Square:</span> <strong><%= ms.adjusted_R_square %></strong></div>
                      <div style="display: flex; justify-content: space-between;"><span>Durbin-Watson:</span> <strong><%= ms.durbin_watson %></strong></div>
                    </div>
                  </div>
                </div>

                <div class="card">
                  <div class="card-header" style="background: var(--bg-subtle);">
                    <h4 style="margin: 0; font-size: 0.95rem;">Tabel 3: ANOVA (Uji Simultan F)</h4>
                  </div>
                  <div class="card-body">
                    <% const anova = result.anova_table || {}; %>
                    <div style="display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.85rem;">
                      <div style="display: flex; justify-content: space-between;"><span>F-Hitung:</span> <strong style="color: #10b981;"><%= anova.F_count %></strong></div>
                      <div style="display: flex; justify-content: space-between;"><span>Sig. (p-value):</span> <strong><%= anova.sig_p %></strong></div>
                      <div style="display: flex; justify-content: space-between;"><span>Keputusan:</span> <span class="badge badge-emerald">Model Fit Signifikan</span></div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- COEFFICIENTS TABLE -->
              <div class="card" style="margin-bottom: 1.5rem;">
                <div class="card-header" style="background: var(--bg-subtle);">
                  <h4 style="margin: 0; font-size: 0.95rem;">Tabel 4: Coefficients (Uji Parsial t)</h4>
                </div>
                <div class="card-body">
                  <div class="spss-table-container">
                    <table class="spss-math-table">
                      <thead>
                        <tr>
                          <th>Model</th>
                          <th>Unstandardized B</th>
                          <th>Std. Error</th>
                          <th>Standardized Beta</th>
                          <th>t-Hitung</th>
                          <th>Sig. (p)</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% (result.coefficients_table || []).forEach(row => { %>
                          <tr>
                            <td><strong><%= row.model %></strong></td>
                            <td><%= row.unstd_B.toFixed(3) %></td>
                            <td><%= row.std_error.toFixed(3) %></td>
                            <td><%= row.beta !== null ? row.beta.toFixed(3) : '-' %></td>
                            <td style="color: #0d9488; font-weight: 700;"><%= row.t_count.toFixed(3) %></td>
                            <td><%= row.sig.toFixed(3) %></td>
                          </tr>
                        <% }); %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            <% } %>

            <!-- JIKA MODUL SMARTPLS (PLS-SEM) -->
            <% if (result.module === 'smartpls') { %>
              <div class="card" style="margin-bottom: 1.5rem;">
                <div class="card-header" style="background: var(--bg-subtle);">
                  <h4 style="margin: 0; font-size: 0.95rem;">1. Measurement Model: Convergent Validity &amp; Reliability</h4>
                </div>
                <div class="card-body">
                  <div class="spss-table-container">
                    <table class="spss-math-table">
                      <thead>
                        <tr>
                          <th>Konstruk Variabel</th>
                          <th>Cronbach Alpha</th>
                          <th>Composite Reliability</th>
                          <th>AVE</th>
                          <th>Status</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% (result.outer_model?.construct_reliability || []).forEach(c => { %>
                          <tr>
                            <td><strong><%= c.construct %></strong></td>
                            <td><%= c.cronbach_alpha.toFixed(3) %></td>
                            <td><%= c.composite_reliability.toFixed(3) %></td>
                            <td><%= c.AVE.toFixed(3) %></td>
                            <td><span class="badge badge-emerald"><%= c.conclusion %></span></td>
                          </tr>
                        <% }); %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>

              <!-- PATH COEFFICIENTS & MEDIATION -->
              <div class="card" style="margin-bottom: 1.5rem;">
                <div class="card-header" style="background: var(--bg-subtle);">
                  <h4 style="margin: 0; font-size: 0.95rem;">2. Structural Model: Path Coefficients &amp; Uji Mediasi VAF</h4>
                </div>
                <div class="card-body">
                  <div class="spss-table-container">
                    <table class="spss-math-table">
                      <thead>
                        <tr>
                          <th>Jalur Hubungan</th>
                          <th>Path Beta</th>
                          <th>Std Dev</th>
                          <th>T-Statistics</th>
                          <th>P-Value</th>
                          <th>Keputusan</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% (result.inner_model?.path_coefficients || []).forEach(p => { %>
                          <tr>
                            <td><strong><%= p.relationship %></strong></td>
                            <td><%= p.path_beta.toFixed(3) %></td>
                            <td><%= p.std_dev.toFixed(3) %></td>
                            <td style="color: #0d9488; font-weight: 700;"><%= p.t_statistics.toFixed(3) %></td>
                            <td><%= p.p_value.toFixed(3) %></td>
                            <td><span class="badge badge-emerald"><%= p.decision %></span></td>
                          </tr>
                        <% }); %>
                      </tbody>
                    </table>
                  </div>

                  <% if (result.inner_model?.mediation_testing) { %>
                    <% const med = result.inner_model.mediation_testing; %>
                    <div style="background: rgba(13, 148, 136, 0.08); border: 1px solid #2dd4bf; border-radius: var(--radius-md); padding: 1rem; margin-top: 1rem; font-size: 0.85rem;">
                      <strong style="color: #0f766e; display: block; margin-bottom: 0.25rem;">Hasil Pengujian Mediasi: <%= med.mediation_type %></strong>
                      <div style="color: var(--text-main);"><%= med.conclusion %> Rasio VAF: <strong><%= med.vaf_ratio %></strong> (t-stat = <%= med.t_statistics_indirect %>).</div>
                    </div>
                  <% } %>
                </div>
              </div>
            <% } %>

            <!-- JIKA MODUL TRANSKRIP KUALITATIF -->
            <% if (result.module === 'transkrip' && result.transcripts) { %>
              <div class="card" style="margin-bottom: 1.5rem;">
                <div class="card-header" style="background: var(--bg-subtle);">
                  <h4 style="margin: 0; font-size: 0.95rem;">Tabel Transkrip Verbatim</h4>
                </div>
                <div class="card-body">
                  <div class="spss-table-container">
                    <table class="spss-math-table">
                      <thead>
                        <tr>
                          <th style="width: 100px;">Timestamp</th>
                          <th style="width: 140px;">Pembicara</th>
                          <th>Pernyataan Verbatim</th>
                          <th>Label / Tag</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% result.transcripts.forEach(t => { %>
                          <tr>
                            <td style="font-family: var(--font-mono);"><%= t.timestamp %></td>
                            <td><strong><%= t.speaker %></strong></td>
                            <td style="font-family: var(--font-sans);"><%= t.dialogue %></td>
                            <td><span class="badge badge-primary" style="font-size: 0.725rem;"><%= t.tag || t.code_label %></span></td>
                          </tr>
                        <% }); %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            <% } %>

            <!-- JIKA MODUL KUALITATIF (KODING & TEMA) -->
            <% if (result.module === 'kualitatif' && result.coding_summary) { %>
              <div class="card" style="margin-bottom: 1.5rem;">
                <div class="card-header" style="background: var(--bg-subtle);">
                  <h4 style="margin: 0; font-size: 0.95rem;">Matriks Koding Terbuka &amp; Frekuensi Tema</h4>
                </div>
                <div class="card-body">
                  <div class="spss-table-container">
                    <table class="spss-math-table">
                      <thead>
                        <tr>
                          <th>Kode Analisis</th>
                          <th>Label Kategori</th>
                          <th>Frekuensi Muncul</th>
                          <th>Sumber Informan</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% result.coding_summary.forEach(c => { %>
                          <tr>
                            <td><code style="color: #059669;"><%= c.code %></code></td>
                            <td><strong><%= c.label %></strong></td>
                            <td><%= c.frequency %> kali</td>
                            <td><%= c.informants %></td>
                          </tr>
                        <% }); %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            <% } %>

            <!-- JIKA MODUL VISUAL VIDEO -->
            <% if (result.module === 'visual' && result.keyframe_breakdown) { %>
              <div class="card" style="margin-bottom: 1.5rem;">
                <div class="card-header" style="background: var(--bg-subtle);">
                  <h4 style="margin: 0; font-size: 0.95rem;">Dekonstruksi Semiotika Keyframe Visual</h4>
                </div>
                <div class="card-body">
                  <div class="spss-table-container">
                    <table class="spss-math-table">
                      <thead>
                        <tr>
                          <th>Adegan &amp; Timestamp</th>
                          <th>Elemen Visual / Mise-en-scène</th>
                          <th>Makna Denotasi</th>
                          <th>Makna Konotasi</th>
                          <th>Mitos / Ideologi</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% result.keyframe_breakdown.forEach(k => { %>
                          <tr>
                            <td><strong><%= k.scene %></strong></td>
                            <td><%= k.visual_element %></td>
                            <td><%= k.denotation %></td>
                            <td><%= k.connotation %></td>
                            <td><em style="color: #d97706;"><%= k.myth %></em></td>
                          </tr>
                        <% }); %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            <% } %>

            <!-- JIKA MODUL DOKUMEN -->
            <% if (result.module === 'dokumen' && result.content_categories) { %>
              <div class="card" style="margin-bottom: 1.5rem;">
                <div class="card-header" style="background: var(--bg-subtle);">
                  <h4 style="margin: 0; font-size: 0.95rem;">Kategorisasi Tematik &amp; Rujukan Teks</h4>
                </div>
                <div class="card-body">
                  <div class="spss-table-container">
                    <table class="spss-math-table">
                      <thead>
                        <tr>
                          <th>Kategori Tematik</th>
                          <th>Kutipan / Nomor Halaman</th>
                          <th>Intisari Temuan Dokumen</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% result.content_categories.forEach(d => { %>
                          <tr>
                            <td><strong><%= d.category %></strong></td>
                            <td><code style="color: #0d9488;"><%= d.citation %></code></td>
                            <td><%= d.finding %></td>
                          </tr>
                        <% }); %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            <% } %>

            <!-- NARASI BAB IV SIAP SALIN -->
            <% if (result.bab4_text || result.bab4_draft) { %>
              <div class="card" style="border: 1px solid #0d9488;">
                <div class="card-header" style="background: rgba(13, 148, 136, 0.08); display: flex; justify-content: space-between; align-items: center;">
                  <h4 style="margin: 0; font-size: 0.95rem; color: #0f766e; font-weight: 700;">
                    Draf Naskah Penyajian Hasil &amp; Pembahasan (BAB IV)
                  </h4>
                  <span class="badge badge-emerald">Siap Tempel Skripsi</span>
                </div>
                <div class="card-body">
                  <div id="bab4NarrationContent" style="background: var(--bg-card); padding: 1.25rem; border-radius: var(--radius-md); font-size: 0.9rem; line-height: 1.7; white-space: pre-wrap; color: var(--text-main);">
                    <%= result.bab4_text || result.bab4_draft %>
                  </div>
                </div>
              </div>
            <% } %>
          </div>
        <% } %>
      </main>
    </div>
  </div>

  <script>
    const toggleBtn = document.getElementById('mobileMenuToggle');
    const sidebar = document.getElementById('dashboardSidebar');
    const overlay = document.getElementById('sidebarOverlay');

    function toggleSidebar() {
      sidebar.classList.toggle('show');
      overlay.classList.toggle('show');
    }
    if (toggleBtn) toggleBtn.addEventListener('click', toggleSidebar);
    if (overlay) overlay.addEventListener('click', toggleSidebar);

    let activeModule = '<%= selectedModule %>';

    function openWorkbench(modKey) {
      activeModule = modKey;
      
      // Sembunyikan Hub 6-card, tampilkan tombol kembali
      const hubGrid = document.getElementById('olahHubGrid');
      const backNav = document.getElementById('navBackContainer');
      if (hubGrid) hubGrid.style.display = 'none';
      if (backNav) backNav.style.display = 'block';

      // Sembunyikan seluruh workbench
      document.querySelectorAll('.olah-workbench-card').forEach(wb => {
        wb.style.display = 'none';
      });

      // Tampilkan workbench yang dipilih
      const targetWb = document.getElementById(`wb_${modKey}`);
      if (targetWb) {
        targetWb.style.display = 'block';
        targetWb.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    function showHubGrid() {
      const hubGrid = document.getElementById('olahHubGrid');
      const backNav = document.getElementById('navBackContainer');
      if (hubGrid) hubGrid.style.display = 'grid';
      if (backNav) backNav.style.display = 'none';

      document.querySelectorAll('.olah-workbench-card').forEach(wb => {
        wb.style.display = 'none';
      });
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Subtab SPSS (Kuisioner vs Data Sekunder)
    function switchSpssTab(tabKey) {
      const btnPrimer = document.getElementById('tab_spss_primer');
      const btnSekunder = document.getElementById('tab_spss_sekunder');
      const subtabInput = document.getElementById('spss_subtab_input');
      
      if (tabKey === 'primer') {
        btnPrimer.classList.add('active');
        btnSekunder.classList.remove('active');
        subtabInput.value = 'kuisioner';
      } else {
        btnPrimer.classList.remove('active');
        btnSekunder.classList.add('active');
        subtabInput.value = 'data_sekunder';
      }
    }

    // Dynamic file upload labels
    function handleFileSelected(input, targetLabelId) {
      const label = document.getElementById(targetLabelId);
      const hiddenInput = document.getElementById(`${targetLabelId}_hidden`);
      if (input.files && input.files.length > 0) {
        const name = input.files[0].name;
        if (label) label.innerText = name;
        if (hiddenInput) hiddenInput.value = name;
      }
    }

    function handleDocFilesSelected(input) {
      const label = document.getElementById('dokumen_dropzone_label');
      if (input.files && input.files.length > 0) {
        const count = input.files.length;
        if (count === 1) {
          label.innerText = `✓ File terpilih: ${input.files[0].name}`;
        } else {
          label.innerText = `✓ ${count} dokumen siap dianalisis`;
        }
      }
    }

    // Dynamic Informant Builder for GBR 9
    let informantCount = 1;
    function addInformantBlock() {
      informantCount++;
      const container = document.getElementById('informantsListContainer');
      const div = document.createElement('div');
      div.className = 'informant-item-box';
      div.id = `inf_box_${informantCount}`;
      div.innerHTML = `
        <div class="informant-header">
          <span class="informant-title">Informan ${informantCount}</span>
          <button type="button" class="btn btn-secondary btn-sm" onclick="removeInformantBlock(${informantCount})" style="color: #ef4444; padding: 0.2rem 0.5rem;">Hapus</button>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.75rem;">
          <input type="text" class="form-control form-control-sm" placeholder="Nama / Inisial (mis. Informan ${informantCount})" name="informant_names[]" value="Informan ${informantCount}">
          <input type="text" class="form-control form-control-sm" placeholder="Peran / Jabatan" name="informant_roles[]">
        </div>
        <textarea name="informant_quotes[]" class="form-control form-control-sm" rows="3" placeholder="Salin kutipan wawancara verbatim informan ${informantCount} di sini..."></textarea>
      `;
      container.appendChild(div);
    }

    function removeInformantBlock(idx) {
      const el = document.getElementById(`inf_box_${idx}`);
      if (el) el.remove();
    }

    function copyBab4Text(btn) {
      const el = document.getElementById('bab4NarrationContent');
      if (!el) return;
      navigator.clipboard.writeText(el.innerText).then(() => {
        const old = btn.innerText;
        btn.innerText = 'Tersalin!';
        btn.style.color = '#10b981';
        setTimeout(() => {
          btn.innerText = old;
          btn.style.color = '';
        }, 2000);
      });
    }
  </script>

  <div id="olahDataState" data-auto-open="<%= (locals.result || locals.input?.module_type) ? (locals.selectedModule || '') : '' %>" style="display: none;"></div>

  <script>
    // Auto open selected workbench if submitted or result available
    document.addEventListener('DOMContentLoaded', () => {
      const stateEl = document.getElementById('olahDataState');
      const mod = stateEl ? stateEl.getAttribute('data-auto-open') : '';
      if (mod) {
        openWorkbench(mod);
      }
    });
  </script>
</body>
</html>