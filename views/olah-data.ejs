<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/png" href="/img/dentshubriset.png">
  <link rel="shortcut icon" type="image/png" href="/img/dentshubriset.png">
  <link rel="apple-touch-icon" href="/img/dentshubriset.png">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
</head>
<body>

  <div class="dashboard-layout">
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <aside class="dashboard-sidebar" id="dashboardSidebar">
      <div class="sidebar-header">
        <a href="/dashboard" class="brand-logo">
          <img src="/img/dentshubriset.png" alt="DENTSHUB RISET Logo" class="logo-icon-img">
          <span>DENTSHUB<span class="text-primary">RISET</span></span>
        </a>
      </div>

      <div class="sidebar-content">
        <div>
          <div class="sidebar-nav-group-title">Navigasi Utama</div>
          <ul class="sidebar-nav-list">
            <li><a href="/dashboard" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg><span>Dashboard</span></a></li>
            <li><a href="/penelitian" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg><span>Proyek Penelitian</span></a></li>
            <li><a href="/skripsi" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg><span>Lanjutkan Skripsi</span></a></li>
          </ul>
        </div>

        <div>
          <div class="sidebar-nav-group-title">AI Research Tools</div>
          <ul class="sidebar-nav-list">
            <li><a href="/brainstorming" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/></svg><span>Brainstorming Judul</span></a></li>
            <li><a href="/novelty" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12h5l3 7 4-14 3 7h5"/></svg><span>Temukan Novelty</span></a></li>
            <li><a href="/artikel" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><span>Cari Artikel</span></a></li>
            <li><a href="/olah-data" class="sidebar-nav-link active"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg><span>Olah Data</span></a></li>
            <li><a href="/generate-ppt" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg><span>Generate PPT</span></a></li>
            <li><a href="/sidang" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg><span>Simulasi Sidang</span></a></li>
            <li><a href="/ai-writer" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg><span>AI Writer Akademis</span></a></li>
            <li><a href="/parafrase" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/><line x1="4" y1="4" x2="9" y2="9"/></svg><span>Parafrase Skripsi</span></a></li>
            <li><a href="/revisi" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg><span>Lab Revisi Bimbingan</span></a></li>
          </ul>
        </div>

        <div>
          <div class="sidebar-nav-group-title">Sistem & Akun</div>
          <ul class="sidebar-nav-list">
            <li><a href="/kredit" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><line x1="12" y1="6" x2="12" y2="8"/><line x1="12" y1="16" x2="12" y2="18"/></svg><span>Saldo Kredit</span></a></li>
            <li><a href="/billing" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg><span>Beli Paket</span></a></li>
            <li><a href="/pengaturan" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg><span>Pengaturan Akun</span></a></li>
            <% if (currentUser && currentUser.role === 'owner') { %>
              <li><a href="/owner" class="sidebar-nav-link" style="color: #a855f7;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg><span>Owner Portal</span></a></li>
            <% } %>
          </ul>
        </div>
      </div>

      <div class="sidebar-footer">
        <div class="user-mini-card">
          <div class="user-avatar">
            <%= (currentUser && currentUser.name) ? currentUser.name.charAt(0).toUpperCase() : 'P' %>
          </div>
          <div class="user-meta">
            <span class="user-name"><%= currentUser ? currentUser.name : 'Peneliti' %></span>
            <span class="user-role-badge"><%= currentUser ? currentUser.role.toUpperCase() : 'USER' %></span>
          </div>
        </div>
      </div>
    </aside>

    <div class="dashboard-main">
      <header class="dashboard-topbar">
        <div class="topbar-left">
          <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Buka Menu">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          </button>
          <div style="display: flex; align-items: center; gap: 0.65rem;">
            <div style="width: 34px; height: 34px; border-radius: 8px; background: rgba(37, 99, 235, 0.1); color: var(--primary-600); display: flex; align-items: center; justify-content: center;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            </div>
            <div>
              <h3 style="font-size: 1.15rem; margin: 0; font-weight: 700;">Olah Data</h3>
              <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0;">Pilih jenis olah data sesuai penelitianmu — hasilnya bisa langsung jadi data Bab IV.</p>
            </div>
          </div>
        </div>

        <div class="topbar-right">
          <a href="/kredit" class="credit-pill <%= creditBalance === 'UNLIMITED' ? 'unlimited' : '' %>" title="Saldo Kredit Aktif">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <span id="headerCreditBalance">
              <% if (creditBalance === 'UNLIMITED') { %>
                <span class="unlimited-text"><span class="infinity-symbol">∞</span> UNLIMITED</span>
              <% } else { %>
                <%= creditBalance %> Kredit
              <% } %>
            </span>
          </a>
          <form action="/logout" method="POST" style="margin: 0;">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
            <button type="submit" class="btn btn-secondary btn-sm">Keluar</button>
          </form>
        </div>
      </header>

      <main class="dashboard-content">
        <% if (locals.error) { %>
          <div class="alert alert-danger" role="alert" style="margin-bottom: 1.5rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <div><%= error %></div>
          </div>
        <% } %>

        <%
          const selectedModule = (locals.input && input.module_type) || (locals.result && result.module) || 'spss';
        %>

        <!-- NAVIGASI KEMBALI: PILIH FITUR LAIN -->
        <div id="navBackContainer" style="display: none; margin-bottom: 1rem;">
          <button type="button" class="olah-nav-back" onclick="showHubGrid()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            <span>Pilih fitur lain</span>
          </button>
        </div>

        <!-- 6-CARD GRID PERSIS GAMBAR 5 -->
        <div class="olah-data-hub-grid" id="olahHubGrid">
          <!-- CARD 1: TRANSKRIP AUDIO/VIDEO -->
          <div class="olah-card <%= selectedModule === 'transkrip' ? 'active' : '' %>" onclick="openWorkbench('transkrip')">
            <div>
              <div class="olah-card-icon-wrap" style="background: rgba(14, 165, 233, 0.12); color: #0284c7;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
              </div>
              <h4 class="olah-card-title">
                <span>Transkripsi Audio/Video</span>
                <span>&rsaquo;</span>
              </h4>
              <span class="olah-card-badge" style="background: rgba(14, 165, 233, 0.15); color: #0284c7;">KUALITATIF</span>
              <p class="olah-card-desc">
                Unggah audio <strong>atau video</strong> wawancara &rarr; transkrip otomatis dengan label pembicara & timestamp. Edit, unduh Word, atau lanjut ke Analisis Kualitatif untuk jadi data Bab IV.
              </p>
            </div>
            <div class="olah-card-cost" style="color: #0284c7;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/></svg>
              <span>1 kredit / 10 menit audio</span>
            </div>
          </div>

          <!-- CARD 2: OLAH DATA SPSS (BUKAN AI - REAL MATH TABLES) -->
          <div class="olah-card <%= selectedModule === 'spss' ? 'active' : '' %>" onclick="openWorkbench('spss')">
            <div>
              <div class="olah-card-icon-wrap" style="background: rgba(13, 148, 136, 0.12); color: #0d9488;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
              </div>
              <h4 class="olah-card-title">
                <span>Olah Data SPSS</span>
                <span>&rsaquo;</span>
              </h4>
              <span class="olah-card-badge" style="background: rgba(13, 148, 136, 0.15); color: #0d9488;">KUANTITATIF (BUKAN AI)</span>
              <p class="olah-card-desc">
                Unggah Excel data mentah kuisioner &rarr; uji statistik otomatis (validitas, reliabilitas, asumsi klasik, regresi) dengan tabel gaya SPSS + interpretasi.
              </p>
            </div>
            <div class="olah-card-cost" style="color: #0d9488;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/></svg>
              <span>3 kredit / analisis</span>
            </div>
          </div>

          <!-- CARD 3: OLAH DATA SMARTPLS (BUKAN AI - REAL SEM MATRICES) -->
          <div class="olah-card <%= selectedModule === 'smartpls' ? 'active' : '' %>" onclick="openWorkbench('smartpls')">
            <div>
              <div class="olah-card-icon-wrap" style="background: rgba(13, 148, 136, 0.12); color: #0d9488;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
              </div>
              <h4 class="olah-card-title">
                <span>Olah Data SmartPLS</span>
                <span>&rsaquo;</span>
              </h4>
              <span class="olah-card-badge" style="background: rgba(13, 148, 136, 0.15); color: #0d9488;">PLS-SEM · MEDIASI (BUKAN AI)</span>
              <p class="olah-card-desc">
                Unggah Excel kuisioner &rarr; model persamaan struktural lengkap: outer loadings, reliabilitas & AVE, validitas diskriminan (HTMT), path coefficients + bootstrap, uji mediasi (VAF), R², f², Q², SRMR.
              </p>
            </div>
            <div class="olah-card-cost" style="color: #0d9488;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/></svg>
              <span>5 kredit / analisis</span>
            </div>
          </div>

          <!-- CARD 4: ANALISIS KUALITATIF -->
          <div class="olah-card <%= selectedModule === 'kualitatif' ? 'active' : '' %>" onclick="openWorkbench('kualitatif')">
            <div>
              <div class="olah-card-icon-wrap" style="background: rgba(16, 185, 129, 0.12); color: #059669;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
              </div>
              <h4 class="olah-card-title">
                <span>Analisis Kualitatif</span>
                <span>&rsaquo;</span>
              </h4>
              <span class="olah-card-badge" style="background: rgba(16, 185, 129, 0.15); color: #059669;">KODING & TEMA</span>
              <p class="olah-card-desc">
                Transkrip wawancara &rarr; open coding, kategorisasi, tema, matriks tema&times;informan (Miles & Huberman / Braun & Clarke) &mdash; kutipan diverifikasi verbatim.
              </p>
            </div>
            <div class="olah-card-cost" style="color: #059669;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/></svg>
              <span>2 kredit / analisis</span>
            </div>
          </div>

          <!-- CARD 5: ANALISIS DOKUMEN -->
          <div class="olah-card <%= selectedModule === 'dokumen' ? 'active' : '' %>" onclick="openWorkbench('dokumen')">
            <div>
              <div class="olah-card-icon-wrap" style="background: rgba(20, 184, 166, 0.12); color: #0d9488;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
              </div>
              <h4 class="olah-card-title">
                <span>Analisis Dokumen</span>
                <span>&rsaquo;</span>
              </h4>
              <span class="olah-card-badge" style="background: rgba(20, 184, 166, 0.15); color: #0d9488;">BUKU · NOVEL · ARTIKEL</span>
              <p class="olah-card-desc">
                Unggah PDF/Word (buku, novel, artikel) &rarr; analisis isi/tematik/naratif/wacana: koding, tema, kutipan + nomor halaman &mdash; verbatim, siap jadi Bab IV.
              </p>
            </div>
            <div class="olah-card-cost" style="color: #0d9488;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/></svg>
              <span>2 kredit / analisis</span>
            </div>
          </div>

          <!-- CARD 6: ANALISIS VISUAL VIDEO -->
          <div class="olah-card <%= selectedModule === 'visual' ? 'active' : '' %>" onclick="openWorkbench('visual')">
            <div>
              <div class="olah-card-icon-wrap" style="background: rgba(245, 158, 11, 0.12); color: #d97706;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/><line x1="7" y1="2" x2="7" y2="22"/><line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="2" y1="7" x2="7" y2="7"/><line x1="2" y1="17" x2="7" y2="17"/><line x1="17" y1="17" x2="22" y2="17"/><line x1="17" y1="7" x2="22" y2="7"/></svg>
              </div>
              <h4 class="olah-card-title">
                <span>Analisis Visual Video</span>
                <span>&rsaquo;</span>
              </h4>
              <span class="olah-card-badge" style="background: rgba(245, 158, 11, 0.15); color: #d97706;">FILM · IKLAN · SEMIOTIKA</span>
              <p class="olah-card-desc">
                Unggah video &rarr; sistem ambil keyframe &rarr; analisis <strong>visual</strong> (semiotika, mise-en-scène): adegan kunci, makna/simbol, tema visual + narasi.
              </p>
            </div>
            <div class="olah-card-cost" style="color: #d97706;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/></svg>
              <span>3 kredit / video</span>
            </div>
          </div>
        </div>

        <!-- DEDICATED WORKBENCHES CONTAINER -->
        <div id="workbenchContainer">
          <!-- ===================================================================
               WORKBENCH 2: ANALISIS STATISTIK SPSS (KUANTITATIF) - PERSIS GBR 7
               =================================================================== -->
          <div class="card olah-workbench-card" id="wb_spss" style="border: 1px solid var(--border-color); background: var(--bg-card); border-radius: var(--radius-lg); margin-bottom: 2rem;">
            <div class="card-body" style="padding: 1.75rem;">
              <div style="display: flex; align-items: flex-start; gap: 1rem; margin-bottom: 1.25rem;">
                <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(13, 148, 136, 0.15); color: #0d9488; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
