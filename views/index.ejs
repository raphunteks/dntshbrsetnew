  <!-- 7. FAQPage Schema (Google Rich Results Q&A Accordion) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Apakah saya perlu paham prompt AI untuk memakai Dentshub Riset?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Tidak sama sekali. Platform Dentshub Riset dirancang dengan filosofi Zero Prompt Barrier. Anda hanya perlu memasukkan data dasar penelitian seperti topik minat, variabel, metode, dan target bab. Seluruh rekayasa prompt akademis dan rantai penalaran ilmiah terstruktur disusun otomatis di balik layar."
        }
      },
      {
        "@type": "Question",
        "name": "Bagaimana Dentshub Riset menjamin keaslian sitasi (Zero AI Fabrication)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Di Dentshub Riset kami memegang teguh prinsip Zero AI Fabrication. Setiap kali rujukan diusulkan, sistem menarik metadata langsung via API pangkalan data ilmiah dunia seperti Crossref, PubMed, SINTA, DOAJ, dan Scopus lengkap dengan tautan Digital Object Identifier (DOI) resmi aktif."
        }
      },
      {
        "@type": "Question",
        "name": "Apakah format dan susunan bab dapat disesuaikan dengan pedoman kampus saya?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sangat sesuai dan fleksibel. Fitur BAB Skripsi Dinamis kami memungkinkan penyesuaian struktur penuh, mulai dari 5 Bab baku, 6 Bab, hingga format manuskrip IMRaD untuk publikasi jurnal ilmiah nasional maupun internasional."
        }
      },
      {
        "@type": "Question",
        "name": "Apakah penggunaan Dentshub Riset menggantikan peran dosen pembimbing saya?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Tentu saja tidak. Dentshub Riset memposisikan diri sebagai Pre-Consultation Research Assistant — asisten persiapan mandiri sebelum Anda berhadapan dengan dosen pembimbing (dospem). Keputusan substansi dan persetujuan (ACC) akhir tetap merupakan otoritas dosen pembimbing."
        }
      },
      {
        "@type": "Question",
        "name": "Bagaimana jaminan keamanan dari deteksi plagiarisme dan uji Turnitin?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Modul Academic Paraphraser & Synthesizer kami merombak konstruksi sintaksis dan memadukan variasi klausa aktif-pasif ilmiah berdasarkan kaidah EYD V dan saintifik global, terbukti efektif menekan angka similarity index Turnitin maupun iThenticate ke batas aman universitas."
        }
      },
      {
        "@type": "Question",
        "name": "Apakah data mentah, judul, dan draf karya tulis saya aman serta dijamin rahasia?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Kerahasiaan data intelektual Anda dijamin 100%. Data diisolasi dengan enkripsi AES-256 dan protokol SSL/TLS, serta TIDAK PERNAH digunakan sebagai data pelatihan (training data) model AI pihak ketiga. Hak cipta sepenuhnya milik Anda."
        }
      },
      {
        "@type": "Question",
        "name": "Bagaimana sistem saldo kredit bekerja? Apakah memiliki masa kedaluwarsa?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sistem kredit Dentshub Riset menerapkan skema Lifetime Ownership (Tanpa Batas Waktu / No Expiry). Kredit tidak pernah hangus atau kedaluwarsa, dan pemakaian tercatat transparan di Buku Besar Akun (Audit Ledger)."
        }
      },
      {
        "@type": "Question",
        "name": "Karya tulis apa saja yang didukung selain skripsi Sarjana (S1)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Mendukung seluruh jenjang: Sarjana & Profesi (Skripsi, KTI, Case Report), Magister S2 (Tesis, Systematic Literature Review, Meta-analisis), Doktoral S3 (Disertasi, Novelty Theory), dan Dosen/Peneliti (Artikel Jurnal Scopus/SINTA, Proposal Hibah BIMA)."
        }
      },
      {
        "@type": "Question",
        "name": "Bagaimana cara kerja modul Simulasi Sidang & Ujian Skripsi (Defense AI)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Modul Simulasi Sidang AI menganalisis titik-titik krusial naskah Anda yang sering dicecar penguji (sampel, metodologi, bias) dan menyimulasikan tanya-jawab berbobot tinggi lengkap dengan strategi jawaban berbasis bukti (evidence-based defense)."
        }
      },
      {
        "@type": "Question",
        "name": "Apakah platform ini mendukung analisis data statistik (SPSS, SEM-PLS, Uji Klinis)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ya, asisten BAB 4 Hasil & Pembahasan dapat membaca tabel ringkasan uji statistik (t-test, ANOVA, Regresi, Chi-Square, SmartPLS/SEM) lalu merangkai interpretasi ilmiah baku dan menyambungkannya dengan pembahasan komparatif literatur."
        }
      },
      {
        "@type": "Question",
        "name": "Metode pembayaran apa saja yang didukung untuk pembelian kredit atau langganan?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Mendukung QRIS Real-Time (GoPay, OVO, DANA, ShopeePay, Mobile Banking BCA, Mandiri, BRI, BNI, dll), Virtual Account otomatis, dan Transfer Bank untuk paket institusi kampus resmi."
        }
      },
      {
        "@type": "Question",
        "name": "Bagaimana cara menghubungi tim Customer Care & Konsultasi Resmi Dentshub Riset?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Anda dapat menghubungi Customer Care resmi melalui WhatsApp di <%= waDisplay %>, surel di <%= contactEmail %>, atau tombol floating WhatsApp interaktif di pojok kanan bawah website kami."
        }
      }
    ]
  }
  </script>

