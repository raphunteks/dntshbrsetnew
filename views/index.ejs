  <!-- INTERACTIVE SCRIPTS -->
  <script>
    // 1. FAQ Accordion Interaction
    const faqItems = document.querySelectorAll('.faq-item');
    faqItems.forEach(item => {
      const btn = item.querySelector('.faq-question-btn');
      if (btn) {
        btn.addEventListener('click', () => {
          const isActive = item.classList.contains('active');
          faqItems.forEach(other => other.classList.remove('active'));
          if (!isActive) {
            item.classList.add('active');
          }
        });
      }
    });

    // 2. Pricing Switcher Tabs (Mahasiswa vs Profesor)
    function switchPricingTab(tab) {
      const tabBtnMhs = document.getElementById('tabBtnMahasiswa');
      const tabBtnProf = document.getElementById('tabBtnProfesor');
      const panelMhs = document.getElementById('panelMahasiswa');
      const panelProf = document.getElementById('panelProfesor');

      if (tab === 'mahasiswa') {
        if (tabBtnMhs) tabBtnMhs.classList.add('active');
        if (tabBtnProf) tabBtnProf.classList.remove('active');
        if (panelMhs) panelMhs.classList.add('active');
        if (panelProf) panelProf.classList.remove('active');
      } else {
        if (tabBtnProf) tabBtnProf.classList.add('active');
        if (tabBtnMhs) tabBtnMhs.classList.remove('active');
        if (panelProf) panelProf.classList.add('active');
        if (panelMhs) panelMhs.classList.remove('active');
      }
    }

    // 3. Mobile Navigation Drawer
    const mobileToggle = document.getElementById('mobileNavToggle');
    const mobileDrawer = document.getElementById('mobileDrawer');
    if (mobileToggle && mobileDrawer) {
      mobileToggle.addEventListener('click', () => {
        mobileDrawer.classList.toggle('active');
      });
      document.querySelectorAll('.mobile-link').forEach(link => {
        link.addEventListener('click', () => {
          mobileDrawer.classList.remove('active');
        });
      });
    }

    // 4. Sticky Header Blur Shadow on Scroll
    const navbar = document.getElementById('publicNavbar');
    window.addEventListener('scroll', () => {
      if (navbar) {
        if (window.scrollY > 20) {
          navbar.classList.add('scrolled');
        } else {
          navbar.classList.remove('scrolled');
        }
      }
    });

    // 5. Default Light Theme & Instant Theme Toggler (Strict Default: Light)
    const themeBtn = document.getElementById('themeToggleBtn');
    const mobileThemeBtn = document.getElementById('mobileThemeToggleBtn');
    const themeIcon = document.getElementById('themeIcon');
    const themeText = document.getElementById('themeText');
    const mobileThemeIcon = document.getElementById('mobileThemeIcon');
    const mobileThemeText = document.getElementById('mobileThemeText');

    function updateThemeUI(isDark) {
      if (isDark) {
        document.body.classList.add('dark-theme');
        document.body.classList.remove('light-theme');
        if (themeIcon) themeIcon.textContent = '☀️';
        if (themeText) themeText.textContent = 'Mode Terang';
        if (mobileThemeIcon) mobileThemeIcon.textContent = '☀️';
        if (mobileThemeText) mobileThemeText.textContent = 'Ganti ke Mode Terang';
      } else {
        document.body.classList.remove('dark-theme');
        document.body.classList.add('light-theme');
        if (themeIcon) themeIcon.textContent = '🌙';
        if (themeText) themeText.textContent = 'Mode Gelap';
        if (mobileThemeIcon) mobileThemeIcon.textContent = '🌙';
        if (mobileThemeText) mobileThemeText.textContent = 'Ganti ke Mode Gelap';
      }
    }

    // STRICT DEFAULT IS LIGHT MODE:
    // If user explicitly switched to dark before, honor it; otherwise ensure light theme
    const savedTheme = localStorage.getItem('dentshub_theme');
    let isDarkMode = (savedTheme === 'dark');
    updateThemeUI(isDarkMode);

    function toggleTheme() {
      isDarkMode = !isDarkMode;
      localStorage.setItem('dentshub_theme', isDarkMode ? 'dark' : 'light');
      updateThemeUI(isDarkMode);
    }

    if (themeBtn) {
      themeBtn.addEventListener('click', (e) => {
        e.preventDefault();
        toggleTheme();
      });
    }

    if (mobileThemeBtn) {
      mobileThemeBtn.addEventListener('click', (e) => {
        e.preventDefault();
        toggleTheme();
      });
    }

    // 6. Interactive Floating WhatsApp Popup (Gambar 2)
    const waBtn = document.getElementById('floatingWaBtn');
    const waPopup = document.getElementById('floatingWaPopup');
    const waCloseBtn = document.getElementById('floatingWaCloseBtn');
    const waSendBtn = document.getElementById('floatingWaSendBtn');
    const waInput = document.getElementById('floatingWaInput');
    const adminWaNumber = '<%= (companyProfile && companyProfile.contact && companyProfile.contact.whatsapp) ? companyProfile.contact.whatsapp : "6285338922586" %>';

    if (waBtn && waPopup) {
      waBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const isOpen = waPopup.classList.toggle('active');
        if (isOpen && waInput) {
          setTimeout(() => waInput.focus(), 150);
        }
      });
    }

    if (waCloseBtn && waPopup) {
      waCloseBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        waPopup.classList.remove('active');
      });
    }

    if (waSendBtn) {
      waSendBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const msg = (waInput && waInput.value.trim()) 
          ? waInput.value.trim() 
          : 'Halo Admin Dentshub Riset, saya ingin konsultasi seputar layanan riset & skripsi.';
        const targetUrl = 'https://wa.me/' + adminWaNumber + '?text=' + encodeURIComponent(msg);
        window.open(targetUrl, '_blank', 'noopener,noreferrer');
        if (waPopup) waPopup.classList.remove('active');
      });
    }

    if (waInput) {
      waInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          if (waSendBtn) waSendBtn.click();
        }
      });
    }

    // Close WhatsApp popup when clicking outside
    document.addEventListener('click', (e) => {
      if (waPopup && waPopup.classList.contains('active')) {
        if (!waPopup.contains(e.target) && !waBtn.contains(e.target)) {
          waPopup.classList.remove('active');
        }
      }
    });

    // 7. Progressive Web App (PWA) & Service Worker Controller
    let deferredPwaPrompt = null;
    const isIosDevice = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
    const isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;

    // Register Service Worker for PWA
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js', { scope: '/' })
          .then((reg) => console.log('[PWA] Service Worker aktif:', reg.scope))
          .catch((err) => console.warn('[PWA] Service Worker gagal terdaftar:', err));
      });
    }

    // Capture beforeinstallprompt (Android, Chrome, Edge)
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPwaPrompt = e;
      const pwaBtn = document.getElementById('btnInstallPwa');
      if (pwaBtn) pwaBtn.classList.add('pulse');
    });

    window.addEventListener('appinstalled', () => {
      deferredPwaPrompt = null;
      showPwaToast('Aplikasi Dentshub Riset berhasil dipasang di perangkat Anda!');
    });

    function showPwaToast(message) {
      const toast = document.createElement('div');
      toast.className = 'pwa-toast';
      toast.textContent = message;
      document.body.appendChild(toast);
      setTimeout(() => toast.classList.add('show'), 50);
      setTimeout(() => {
        toast.classList.remove('show');
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    function openPwaModal() {
      const modal = document.getElementById('pwaInstallModal');
      const backdrop = document.getElementById('pwaModalBackdrop');
      const iosGuide = document.getElementById('pwaIosGuide');
      const desktopGuide = document.getElementById('pwaDesktopGuide');

      if (isIosDevice) {
        if (iosGuide) iosGuide.style.display = 'block';
        if (desktopGuide) desktopGuide.style.display = 'none';
      } else {
        if (iosGuide) iosGuide.style.display = 'none';
        if (desktopGuide) desktopGuide.style.display = 'block';
      }

      if (modal && backdrop) {
        modal.classList.add('active');
        backdrop.classList.add('active');
      }
    }

    function closePwaModalFunc() {
      const modal = document.getElementById('pwaInstallModal');
      const backdrop = document.getElementById('pwaModalBackdrop');
      if (modal && backdrop) {
        modal.classList.remove('active');
        backdrop.classList.remove('active');
      }
    }

    async function handlePwaInstall() {
      if (isStandalone) {
        showPwaToast('Aplikasi Dentshub Riset sudah terpasang di perangkat Anda!');
        return;
      }

      if (deferredPwaPrompt) {
        try {
          deferredPwaPrompt.prompt();
          const { outcome } = await deferredPwaPrompt.userChoice;
          if (outcome === 'accepted') {
            showPwaToast('Memasang Dentshub Riset...');
          }
          deferredPwaPrompt = null;
        } catch (err) {
          openPwaModal();
        }
      } else {
        openPwaModal();
      }
    }

    const btnInstall = document.getElementById('btnInstallPwa');
    const btnMobileInstall = document.getElementById('btnMobileInstallPwa');
    const closePwaBtn = document.getElementById('closePwaModal');
    const pwaBackdrop = document.getElementById('pwaModalBackdrop');
    const btnPwaAction = document.getElementById('btnPwaModalAction');

    if (btnInstall) btnInstall.addEventListener('click', handlePwaInstall);
    if (btnMobileInstall) btnMobileInstall.addEventListener('click', handlePwaInstall);
    if (closePwaBtn) closePwaBtn.addEventListener('click', closePwaModalFunc);
    if (pwaBackdrop) pwaBackdrop.addEventListener('click', closePwaModalFunc);
    if (btnPwaAction) btnPwaAction.addEventListener('click', closePwaModalFunc);
  </script>

  <!-- =========================================================
       MODAL PANDUAN INSTALASI PWA (IOS SAFARI, CHROME EXTENSIONS & DESKTOP)
       ========================================================= -->
  <div class="pwa-modal-backdrop" id="pwaModalBackdrop"></div>
  <div class="pwa-install-modal" id="pwaInstallModal" role="dialog" aria-modal="true" aria-labelledby="pwaModalTitle">
    <div class="pwa-modal-header">
      <div class="pwa-modal-header-left">
        <div class="pwa-app-icon">
          <img src="/img/dentshubriset.png" alt="Dentshub Riset Logo">
        </div>
        <div>
          <h3 id="pwaModalTitle" class="pwa-modal-title">Pasang Dentshub Riset</h3>
          <p class="pwa-modal-subtitle">Aplikasi Web Progresif (PWA) Cepat & Ringan</p>
        </div>
      </div>
      <button type="button" class="pwa-modal-close" id="closePwaModal" aria-label="Tutup Panduan">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <div class="pwa-modal-body">
      <!-- State iOS -->
      <div class="pwa-ios-guide" id="pwaIosGuide">
        <div class="pwa-notice-pill">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          <span>Khusus pengguna iPhone / iPad di Safari</span>
        </div>
        <div class="pwa-steps-list">
          <div class="pwa-step-item">
            <div class="pwa-step-number">1</div>
            <div class="pwa-step-content">
              <strong>Ketuk Tombol Bagikan (Share)</strong>
              <p>Tekan ikon kotak panah ke atas <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -2px;"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg> di bilah bawah Safari.</p>
            </div>
          </div>
          <div class="pwa-step-item">
            <div class="pwa-step-number">2</div>
            <div class="pwa-step-content">
              <strong>Pilih "Tambahkan ke Layar Utama"</strong>
              <p>Gulir menu ke bawah lalu pilih opsi <em>"Add to Home Screen"</em> <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -2px;"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>.</p>
            </div>
          </div>
          <div class="pwa-step-item">
            <div class="pwa-step-number">3</div>
            <div class="pwa-step-content">
              <strong>Ketuk "Tambah" di Pojok Kanan Atas</strong>
              <p>Ikon Dentshub Riset akan terpasang di layar utama iPhone/iPad Anda layaknya aplikasi native App Store.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- State Desktop / Chrome Extension / Umum -->
      <div class="pwa-desktop-guide" id="pwaDesktopGuide" style="display: none;">
        <div class="pwa-notice-pill">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          <span>Pemasangan di Komputer / Laptop (Chrome / Edge)</span>
        </div>
        <div class="pwa-steps-list">
          <div class="pwa-step-item">
            <div class="pwa-step-number">1</div>
            <div class="pwa-step-content">
              <strong>Klik Ikon Install di Bilah Alamat</strong>
              <p>Di ujung kanan URL browser Chrome/Edge, klik ikon pasang komputer/laptop <em>"Install Dentshub Riset"</em>.</p>
            </div>
          </div>
          <div class="pwa-step-item">
            <div class="pwa-step-number">2</div>
            <div class="pwa-step-content">
              <strong>Akses Instan dari Desktop</strong>
              <p>Aplikasi akan terbuka di jendela mandiri tanpa bilah browser dengan performa super kilat.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="pwa-modal-footer">
      <button type="button" class="btn-holo" id="btnPwaModalAction" style="width: 100%; justify-content: center;">
        <span>Saya Mengerti</span>
      </button>
    </div>
  </div>
</body>
</html>