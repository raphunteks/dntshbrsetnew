  const isLocalEnv = cleanBaseUrl.includes('localhost') || cleanBaseUrl.includes('127.0.0.1');
  const publicShareBaseUrl = isLocalEnv ? 'https://dentshub.id' : cleanBaseUrl;

  // Aset gambar thumbnail persegi 1:1 (< 300 KB, lolos crawler WhatsApp & media sosial)
  const shareImageUrl = publicShareBaseUrl + '/img/og-thumbnail.png';
  const shareImageJpg = publicShareBaseUrl + '/img/og-thumbnail.jpg';
  const siteTitle = (typeof title !== 'undefined' && title) ? title : 'DENTSHUB RISET - Platform AI Asisten Riset, Skripsi & Publikasi Ilmiah Terpadu';
  const siteDesc = 'Platform AI terdepan untuk mahasiswa S1-S3 & peneliti. Susun skripsi Bab 1-5, tesis, disertasi, hingga artikel jurnal SINTA & Scopus otomatis dengan referensi DOI valid (Zero AI Fabrication), parafrase anti-plagiasi Turnitin, dan simulasi sidang AI.';
  const siteKeywords = 'skripsi AI, tesis AI, disertasi AI, asisten riset, penyusunan bab skripsi, parafrase ilmiah, cek plagiasi turnitin, sitasi otomatis doi, jurnal scopus, jurnal sinta, simulasi sidang skripsi, brainstorming judul skripsi, novelty riset, dentshub riset, asisten akademik';
  const waContact = (typeof companyProfile !== 'undefined' && companyProfile && companyProfile.contact) ? companyProfile.contact.whatsapp : '6285338922586';
  const waDisplay = (typeof companyProfile !== 'undefined' && companyProfile && companyProfile.contact && companyProfile.contact.whatsappDisplay) ? companyProfile.contact.whatsappDisplay : '+62 853-3892-2586';
  const contactEmail = (typeof companyProfile !== 'undefined' && companyProfile && companyProfile.contact && companyProfile.contact.email) ? companyProfile.contact.email : 'kontak@dentshubriset.id';
