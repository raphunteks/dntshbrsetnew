<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/png" href="/img/dentshubriset.png">
  <link rel="shortcut icon" type="image/png" href="/img/dentshubriset.png">
  <link rel="apple-touch-icon" href="/img/dentshubriset.png">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
</head>
<body>

  <div class="dashboard-layout">
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <aside class="dashboard-sidebar" id="dashboardSidebar">
      <div class="sidebar-header">
        <a href="/dashboard" class="brand-logo">
          <img src="/img/dentshubriset.png" alt="DENTSHUB RISET Logo" class="logo-icon-img">
          <span>DENTSHUB<span class="text-primary">RISET</span></span>
        </a>
      </div>

      <div class="sidebar-content">
        <div>
          <div class="sidebar-nav-group-title">Navigasi Utama</div>
          <ul class="sidebar-nav-list">
            <li><a href="/dashboard" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg><span>Dashboard</span></a></li>
            <li><a href="/penelitian" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg><span>Project Penelitian</span></a></li>
            <li><a href="/skripsi" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg><span>Penyusunan BAB</span></a></li>
          </ul>
        </div>

        <div>
          <div class="sidebar-nav-group-title">AI Research Tools</div>
          <ul class="sidebar-nav-list">
            <li><a href="/brainstorming" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/></svg><span>Brainstorming Judul</span></a></li>
            <li><a href="/novelty" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12h5l3 7 4-14 3 7h5"/></svg><span>Temukan Novelty</span></a></li>
            <li><a href="/artikel" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><span>Pencarian Artikel</span></a></li>
            <li><a href="/olah-data" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg><span>Olah Data Riset</span></a></li>
            <li><a href="/generate-ppt" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg><span>Generate PPT Sidang</span></a></li>
            <li><a href="/sidang" class="sidebar-nav-link active"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg><span>Simulasi Sidang</span></a></li>
            <li><a href="/ai-writer" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg><span>AI Writer Akademis</span></a></li>
            <li><a href="/parafrase" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/><line x1="4" y1="4" x2="9" y2="9"/></svg><span>Parafrase Skripsi</span></a></li>
            <li><a href="/revisi" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg><span>Lab Revisi Bimbingan</span></a></li>
          </ul>
        </div>

        <div>
          <div class="sidebar-nav-group-title">Sistem & Akun</div>
          <ul class="sidebar-nav-list">
            <li><a href="/kredit" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><line x1="12" y1="6" x2="12" y2="8"/><line x1="12" y1="16" x2="12" y2="18"/></svg><span>Saldo Kredit</span></a></li>
            <li><a href="/billing" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg><span>Beli Paket</span></a></li>
            <li><a href="/pengaturan" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg><span>Pengaturan Akun</span></a></li>
          </ul>
        </div>
      </div>

      <div class="sidebar-footer">
        <div class="user-mini-card">
          <div class="user-avatar">
            <%= (currentUser && currentUser.name) ? currentUser.name.charAt(0).toUpperCase() : 'P' %>
          </div>
          <div class="user-meta">
            <span class="user-name"><%= currentUser ? currentUser.name : 'Peneliti' %></span>
            <span class="user-role-badge"><%= currentUser ? currentUser.role.toUpperCase() : 'USER' %></span>
          </div>
        </div>
      </div>
    </aside>

    <div class="dashboard-main">
      <header class="dashboard-topbar">
        <div class="topbar-left">
          <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Buka Menu">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          </button>
          <div><h3 style="font-size: 1.15rem; margin: 0;">Simulasi Sidang Skripsi &amp; Ujian Tesis (Voice AI)</h3></div>
        </div>

        <div class="topbar-right">
          <a href="/kredit" class="credit-pill <%= creditBalance === 'UNLIMITED' ? 'unlimited' : '' %>" title="Saldo Kredit Aktif">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <% if (creditBalance === 'UNLIMITED') { %>
              <span class="unlimited-text"><span class="infinity-symbol">∞</span> UNLIMITED</span>
            <% } else { %>
              <span><%= creditBalance %> Kredit</span>
            <% } %>
          </a>
          <form action="/logout" method="POST" style="margin: 0;">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
            <button type="submit" class="btn btn-secondary btn-sm">Keluar</button>
          </form>
        </div>
      </header>

      <main class="dashboard-content">
        <% if (locals.error) { %>
          <div class="alert alert-danger" role="alert">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <div><%= error %></div>
          </div>
        <% } %>

        <div class="tool-hero-header">
          <div>
            <h2 style="font-size: 1.65rem; margin-bottom: 0.25rem;">Simulasi Sidang Interaktif dengan Voice AI</h2>
            <p style="color: var(--text-muted); margin: 0;">
              Latih mental dan argumen lisan Anda langsung bersama Dewan Penguji AI bersuara (Text-to-Speech) &amp; jawab menggunakan mikrofon (Speech-to-Text).
            </p>
          </div>
          <div class="tool-badge-pill">
            <span>Biaya Sesi:</span>
            <strong><%= creditCost %> Kredit</strong>
          </div>
        </div>

        <!-- PILIHAN 4 PERSONA DOSEN PENGUJI (PERSIS GBR 14-16) -->
        <div style="margin-bottom: 1.5rem;">
          <label class="form-label" style="font-weight: 700; font-size: 0.9rem; margin-bottom: 0.75rem; display: block;">
            Pilih Karakter &amp; Persona Dewan Penguji:
          </label>
          <div class="examiner-cards-grid">
            <!-- PERSONA 1: METODOLOGI KRITIS -->
            <div class="examiner-card <%= (input.examiner_persona || '').includes('Sudirman') ? 'active' : '' %>" onclick="selectExaminer('Prof. Dr. Ir. H. Sudirman (Penguji Metodologi Kritis)', this)">
              <div class="examiner-avatar" style="background: linear-gradient(135deg, #2563eb, #1e40af);">PS</div>
              <div class="examiner-name">Prof. Dr. Ir. H. Sudirman</div>
              <div class="examiner-role">Ketua Penguji · Metodologi Kritis</div>
              <div class="examiner-specialty">Ketat pada teknik sampling, validitas internal, confounding variables, dan signifikansi statistik.</div>
            </div>

            <!-- PERSONA 2: TEORI ORTODOKS & NOVELTY -->
            <div class="examiner-card <%= (input.examiner_persona || '').includes('Sri Wahyuni') ? 'active' : '' %>" onclick="selectExaminer('Dr. Sri Wahyuni, M.Si (Penguji Landasan Teori & Novelty)', this)">
              <div class="examiner-avatar" style="background: linear-gradient(135deg, #9333ea, #6b21a8);">SW</div>
              <div class="examiner-name">Dr. Sri Wahyuni, M.Si</div>
              <div class="examiner-role">Penguji Utama · Teori &amp; Novelty</div>
              <div class="examiner-specialty">Fokus menguliti kesesuaian Grand Theory, kesenjangan riset (gap), dan orisinalitas kebaruan ilmiah.</div>
            </div>

            <!-- PERSONA 3: STATISTIK & KUANTITATIF DETAIL -->
            <div class="examiner-card <%= (input.examiner_persona || '').includes('Antonius') ? 'active' : '' %>" onclick="selectExaminer('Dr. Antonius Wijaya, M.Kom / M.Stat (Penguji Statistik Detail)', this)">
              <div class="examiner-avatar" style="background: linear-gradient(135deg, #0d9488, #0f766e);">AW</div>
              <div class="examiner-name">Dr. Antonius Wijaya, M.Stat</div>
              <div class="examiner-role">Penguji Ahli · Statistik Detail</div>
              <div class="examiner-specialty">Menyerang p-value, normalitas data, pemilihan uji parametrik vs non-parametrik, dan R-Square.</div>
            </div>

            <!-- PERSONA 4: SOLUTIF & TERAPAN -->
            <div class="examiner-card <%= (input.examiner_persona || '').includes('Nurhayati') ? 'active' : '' %>" onclick="selectExaminer('Dr. Hj. Nurhayati, M.Kes / M.Pd (Penguji Solutif & Terapan)', this)">
              <div class="examiner-avatar" style="background: linear-gradient(135deg, #d97706, #b45309);">NH</div>
              <div class="examiner-name">Dr. Hj. Nurhayati, M.Kes</div>
              <div class="examiner-role">Sekretaris Penguji · Solutif &amp; Terapan</div>
              <div class="examiner-specialty">Menguji implikasi praktis, kode etik penelitian, dan kelayakan rekomendasi bagi institusi/lapangan.</div>
            </div>
          </div>
        </div>

        <div class="ai-tool-layout" style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 1.5rem;">
          <!-- KOLOM KIRI: FORM PENGATURAN SESI -->
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">Pengaturan Sesi Ujian</h3>
            </div>
            <form action="/sidang" method="POST" id="sidangForm">
              <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
              <input type="hidden" name="examiner_persona" id="examiner_persona_input" value="<%= input.examiner_persona || 'Prof. Dr. Ir. H. Sudirman (Penguji Metodologi Kritis)' %>">

              <div class="card-body">
                <!-- PILIHAN JURUSAN / FAKULTAS -->
                <div class="form-group">
                  <label for="department" class="form-label" style="font-weight: 600;">Jurusan / Program Studi Anda *</label>
                  <select id="department" name="department" class="form-control">
                    <option value="Kedokteran Gigi & Mulut" <%= input.department === 'Kedokteran Gigi & Mulut' ? 'selected' : '' %>>Kedokteran Gigi &amp; Mulut (Dental Sciences)</option>
                    <option value="Kedokteran Umum & Klinis" <%= input.department === 'Kedokteran Umum & Klinis' ? 'selected' : '' %>>Kedokteran Umum &amp; Spesialis</option>
                    <option value="Farmasi & Biomedis" <%= input.department === 'Farmasi & Biomedis' ? 'selected' : '' %>>Farmasi &amp; Ilmu Biomedis</option>
                    <option value="Ilmu Keperawatan & Kebidanan" <%= input.department === 'Ilmu Keperawatan & Kebidanan' ? 'selected' : '' %>>Ilmu Keperawatan &amp; Kebidanan</option>
                    <option value="Manajemen & Bisnis" <%= input.department === 'Manajemen & Bisnis' ? 'selected' : '' %>>Manajemen, Akuntansi &amp; Bisnis</option>
                    <option value="Ilmu Hukum" <%= input.department === 'Ilmu Hukum' ? 'selected' : '' %>>Ilmu Hukum (Pidana / Perdata / Tata Negara)</option>
                    <option value="Teknik Informatika & Komputer" <%= input.department === 'Teknik Informatika & Komputer' ? 'selected' : '' %>>Teknik Informatika &amp; Ilmu Komputer</option>
                    <option value="Teknik Sipil & Mesin" <%= input.department === 'Teknik Sipil & Mesin' ? 'selected' : '' %>>Teknik Sipil, Mesin, Elektro, Industri</option>
                    <option value="Psikologi & Perilaku" <%= input.department === 'Psikologi & Perilaku' ? 'selected' : '' %>>Psikologi &amp; Ilmu Perilaku</option>
                    <option value="Ilmu Komunikasi & FISIP" <%= input.department === 'Ilmu Komunikasi & FISIP' ? 'selected' : '' %>>Ilmu Komunikasi &amp; Hubungan Internasional</option>
                    <option value="Pendidikan & Keguruan (FKIP)" <%= input.department === 'Pendidikan & Keguruan (FKIP)' ? 'selected' : '' %>>Pendidikan &amp; Keguruan (FKIP / Tarbiyah)</option>
                  </select>
                </div>

                <!-- TOPIK ATAU JUDUL -->
                <div class="form-group">
                  <label for="topic" class="form-label" style="font-weight: 600;">Topik atau Judul Skripsi *</label>
                  <input type="text" id="topic" name="topic" class="form-control" placeholder="Contoh: Efektivitas Ekstrak Daun Sirih Terhadap Hambatan Bakteri S. mutans" value="<%= input.topic || '' %>" required minlength="3">
                </div>

                <!-- FOKUS KATEGORI -->
                <div class="form-group">
                  <label for="category" class="form-label" style="font-weight: 600;">Fokus Sesi Ujian Dewan Penguji *</label>
                  <select id="category" name="category" class="form-control">
                    <option value="metodologi" <%= input.category === 'metodologi' ? 'selected' : '' %>>Metodologi &amp; Desain Riset</option>
                    <option value="teori" <%= input.category === 'teori' ? 'selected' : '' %>>Landasan Teori &amp; Kerangka Berpikir</option>
                    <option value="hasil" <%= input.category === 'hasil' ? 'selected' : '' %>>Hasil Uji &amp; Pembahasan Temuan</option>
                    <option value="kontribusi" <%= input.category === 'kontribusi' ? 'selected' : '' %>>Novelty &amp; Kontribusi Ilmiah</option>
                    <option value="limitation" <%= input.category === 'limitation' ? 'selected' : '' %>>Keterbatasan &amp; Generalisasi Riset</option>
                  </select>
                </div>

                <!-- VOICE MIC TOOLBAR UNTUK JAWABAN KANDIDAT -->
                <div class="form-group">
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.45rem;">
                    <label for="user_answer" class="form-label" style="font-weight: 600; margin: 0;">
                      Jawaban Lisan Kandidat (Bicara atau Ketik)
                    </label>
                    <button type="button" class="voice-mic-btn" id="btnMicInput" onclick="toggleVoiceRecording()">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
                      <span id="micBtnLabel">Jawab via Mic</span>
                    </button>
                  </div>

                  <div id="micStatusIndicator" style="display: none; align-items: center; gap: 0.5rem; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); padding: 0.45rem 0.75rem; border-radius: 6px; margin-bottom: 0.5rem; font-size: 0.8rem; color: #fca5a5;">
                    <div class="voice-wave-container">
                      <span class="voice-wave-bar"></span>
                      <span class="voice-wave-bar"></span>
                      <span class="voice-wave-bar"></span>
                      <span class="voice-wave-bar"></span>
                      <span class="voice-wave-bar"></span>
                    </div>
                    <span>Sedang mendengarkan suara Anda... Silakan bicarakan argumen Anda.</span>
                  </div>

                  <textarea id="user_answer" name="user_answer" class="form-control" rows="5" placeholder="Tekan tombol 'Jawab via Mic' di atas untuk berbicara langsung, atau ketikkan draf jawaban Anda di sini untuk dinilai oleh Dewan Penguji..."><%= input.user_answer || '' %></textarea>
                </div>
              </div>

              <div class="card-footer" style="display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 0.75rem; color: var(--text-muted);">
                  ⏱️ Durasi respons lisan standar: 2–3 menit per pertanyaan.
                </span>
                <button type="submit" class="btn btn-primary" style="font-weight: 700;">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                  <%= (input.user_answer && input.user_answer.length > 5) ? 'Evaluasi Jawaban Saya' : 'Mulai Pertanyaan Penguji' %>
                </button>
              </div>
            </form>
          </div>

          <!-- KOLOM KANAN: PERTANYAAN / LEMBAR PENILAIAN PENGUJI -->
          <div>
            <% if (result) { %>
              <% if (result.mode === 'question_generation') { %>
                <div class="card">
                  <div class="card-header" style="background: var(--bg-subtle); display: flex; justify-content: space-between; align-items: center;">
                    <span class="badge badge-primary"><%= result.category %></span>
                    <span style="font-size: 0.8rem; color: var(--text-muted);">Alokasi Waktu: <%= result.time_allocation_recommended || '2 Menit' %></span>
                  </div>
                  <div class="card-body">
                    <!-- AUDIO VOICE PENGUJI BERSUARA (TTS) -->
                    <div class="voice-toolbar">
                      <div style="display: flex; align-items: center; gap: 0.65rem;">
                        <button type="button" class="voice-speaker-btn" id="btnPlayExaminerVoice" onclick="playExaminerVoice()">
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
                          <span id="speakerBtnLabel">Dengarkan Suara Penguji</span>
                        </button>
                        <div class="voice-wave-container" id="speakerWaveAnim" style="display: none;">
                          <span class="voice-wave-bar" style="background: #3b82f6;"></span>
                          <span class="voice-wave-bar" style="background: #3b82f6;"></span>
                          <span class="voice-wave-bar" style="background: #3b82f6;"></span>
                          <span class="voice-wave-bar" style="background: #3b82f6;"></span>
                          <span class="voice-wave-bar" style="background: #3b82f6;"></span>
                        </div>
                      </div>

                      <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="font-size: 0.775rem; color: var(--text-muted);">Timer Sidang:</span>
                        <span id="defenseTimerDisplay" style="font-family: var(--font-mono); font-weight: 700; color: #2dd4bf; background: rgba(13, 148, 136, 0.15); padding: 0.2rem 0.5rem; border-radius: 4px;">02:00</span>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="startDefenseTimer()" style="padding: 0.2rem 0.45rem; font-size: 0.7rem;">Mulai</button>
                      </div>
                    </div>

                    <div class="examiner-quote-box" style="background: rgba(37, 99, 235, 0.06); border-left: 4px solid #2563eb; padding: 1.25rem; border-radius: 0 8px 8px 0; margin-bottom: 1.5rem;">
                      <div style="font-size: 0.8rem; font-weight: 700; color: #3b82f6; text-transform: uppercase; margin-bottom: 0.4rem;">
                        <%= result.examiner_persona %> — <%= result.department %>
                      </div>
                      <p id="examinerQuestionText" style="font-size: 1.1rem; font-weight: 600; color: var(--text-main); margin: 0; line-height: 1.55;">
                        "<%= result.question %>"
                      </p>
                    </div>

                    <div>
                      <h4 style="font-size: 0.95rem; margin-bottom: 0.65rem; color: var(--text-main);">
                        Poin Titik Kritis yang Ingin Dikuak Penguji (Probing Points):
                      </h4>
                      <ul class="probing-point-list" style="margin: 0; padding-left: 1.25rem; font-size: 0.85rem; line-height: 1.6; color: var(--text-muted);">
                        <% (result.probing_points || []).forEach(point => { %>
                          <li style="margin-bottom: 0.35rem;"><%= point %></li>
                        <% }); %>
                      </ul>
                    </div>

                    <div style="margin-top: 1.5rem; background: var(--bg-subtle); padding: 1rem; border-radius: var(--radius-md); font-size: 0.825rem; border: 1px solid var(--border-color);">
                      💡 <strong>Petunjuk Menjawab:</strong> Tekan tombol mic merah di sebelah kiri untuk merekam suara Anda, atau ketik argumen Anda lalu klik 'Evaluasi Jawaban Saya'.
                    </div>
                  </div>
                </div>
              <% } else if (result.mode === 'answer_evaluation') { %>
                <div class="card">
                  <div class="card-header" style="background: var(--bg-subtle); display: flex; justify-content: space-between; align-items: center;">
                    <h3 class="card-title" style="color: var(--text-main); font-size: 1rem;">Lembar Penilaian Dewan Penguji</h3>
                    <span class="badge badge-emerald"><%= result.rating %></span>
                  </div>
                  <div class="card-body">
                    <div style="display: flex; align-items: center; gap: 1.5rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1.25rem;">
                      <div style="font-size: 3.2rem; font-weight: 800; color: #10b981; font-family: var(--font-mono); line-height: 1;">
                        <%= result.score %><span style="font-size: 1.25rem; color: var(--text-muted);">/100</span>
                      </div>
                      <div>
                        <strong style="font-size: 1.05rem; display: block; color: var(--text-main);"><%= result.rating %></strong>
                        <span style="font-size: 0.825rem; color: var(--text-muted);"><%= result.examiner_persona %></span>
                      </div>
                    </div>

                    <% if (result.aspect_breakdown) { %>
                      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem; background: var(--bg-subtle); padding: 0.85rem; border-radius: 8px;">
                        <div style="font-size: 0.8rem;">Metodologi: <strong><%= result.aspect_breakdown.metodologi %>/100</strong></div>
                        <div style="font-size: 0.8rem;">Landasan Teori: <strong><%= result.aspect_breakdown.teori %>/100</strong></div>
                        <div style="font-size: 0.8rem;">Artikulasi Lisan: <strong><%= result.aspect_breakdown.artikulasi_lisan %>/100</strong></div>
                        <div style="font-size: 0.8rem;">Ketahanan Probing: <strong><%= result.aspect_breakdown.ketahanan_probing %>/100</strong></div>
                      </div>
                    <% } %>

                    <div style="margin-bottom: 1.25rem;">
                      <strong style="display: block; font-size: 0.875rem; color: #10b981; margin-bottom: 0.25rem;">✓ Kelebihan Argumen Anda:</strong>
                      <p style="font-size: 0.85rem; color: var(--text-main); margin: 0; line-height: 1.5;"><%= result.strengths %></p>
                    </div>

                    <div style="margin-bottom: 1.25rem;">
                      <strong style="display: block; font-size: 0.875rem; color: #ef4444; margin-bottom: 0.25rem;">⚠️ Celah yang Belum Terjawab (Blind Spots):</strong>
                      <p style="font-size: 0.85rem; color: var(--text-main); margin: 0; line-height: 1.5;"><%= result.blind_spots %></p>
                    </div>

                    <div>
                      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
                        <strong style="font-size: 0.875rem; color: #3b82f6;">Model Jawaban Standar Ideal:</strong>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="speakModelAnswer()" style="padding: 0.2rem 0.6rem; font-size: 0.75rem;">
                          🔊 Dengarkan Jawaban Ideal
                        </button>
                      </div>
                      <div id="modelAnswerText" style="font-size: 0.875rem; line-height: 1.7; background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.25); padding: 1rem; border-radius: var(--radius-md); color: var(--text-main);">
                        <%= result.recommended_model_answer %>
                      </div>
                    </div>
                  </div>
                </div>
              <% } %>
            <% } else { %>
              <div class="card">
                <div class="card-body" style="text-align: center; padding: 4rem 1.5rem;">
                  <div style="font-size: 3rem; margin-bottom: 1rem;">🎓</div>
                  <h4>Simulasi Sidang Voice AI Siap Dimulai</h4>
                  <p style="max-width: 420px; margin: 0 auto; font-size: 0.9rem; color: var(--text-muted);">
                    Pilih karakter dewan penguji di bagian atas dan tentukan fokus kategori di sisi kiri. Dewan Penguji akan membacakan pertanyaan lisan dan Anda dapat menjawab langsung menggunakan mikrofon.
                  </p>
                </div>
              </div>
            <% } %>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script>
    const toggleBtn = document.getElementById('mobileMenuToggle');
    const sidebar = document.getElementById('dashboardSidebar');
    const overlay = document.getElementById('sidebarOverlay');

    function toggleSidebar() {
      sidebar.classList.toggle('show');
      overlay.classList.toggle('show');
    }
    if (toggleBtn) toggleBtn.addEventListener('click', toggleSidebar);
    if (overlay) overlay.addEventListener('click', toggleSidebar);

    // Seleksi Persona Dosen Penguji
    function selectExaminer(personaName, el) {
      document.querySelectorAll('.examiner-card').forEach(c => c.classList.remove('active'));
      el.classList.add('active');
      document.getElementById('examiner_persona_input').value = personaName;
    }

    // Interactive Text-to-Speech (TTS) Voice of Examiner
    let isSpeaking = false;
    function playExaminerVoice() {
      const textEl = document.getElementById('examinerQuestionText');
      if (!textEl) return;
      const text = textEl.innerText.replace(/"/g, '');

      if (!('speechSynthesis' in window)) {
        window.alert('Browser Anda tidak mendukung Text-to-Speech. Gunakan Chrome, Edge, atau Safari.');
        return;
      }

      if (isSpeaking) {
        window.speechSynthesis.cancel();
        isSpeaking = false;
        document.getElementById('speakerBtnLabel').innerText = 'Dengarkan Suara Penguji';
        document.getElementById('speakerWaveAnim').style.display = 'none';
        return;
      }

      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = 'id-ID';
      utterance.rate = 0.95; // Wibawa akademis
      utterance.pitch = 0.9;

      utterance.onstart = () => {
        isSpeaking = true;
        document.getElementById('speakerBtnLabel').innerText = 'Jeda Suara Penguji';
        document.getElementById('speakerWaveAnim').style.display = 'inline-flex';
      };

      utterance.onend = () => {
        isSpeaking = false;
        document.getElementById('speakerBtnLabel').innerText = 'Putar Ulang Suara';
        document.getElementById('speakerWaveAnim').style.display = 'none';
      };

      utterance.onerror = () => {
        isSpeaking = false;
        document.getElementById('speakerWaveAnim').style.display = 'none';
      };

      window.speechSynthesis.speak(utterance);
    }

    function speakModelAnswer() {
      const textEl = document.getElementById('modelAnswerText');
      if (!textEl) return;
      const text = textEl.innerText;
      if (!('speechSynthesis' in window)) return;
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = 'id-ID';
      utterance.rate = 1.0;
      window.speechSynthesis.speak(utterance);
    }

    // Interactive Speech-to-Text (STT) Microphone Candidate Input
    let recognition = null;
    let isRecording = false;

    function toggleVoiceRecording() {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SpeechRecognition) {
        window.alert('Browser Anda belum mendukung input mikrofon (Speech Recognition). Gunakan Google Chrome atau Edge.');
        return;
      }

      const micBtn = document.getElementById('btnMicInput');
      const micLabel = document.getElementById('micBtnLabel');
      const statusIndicator = document.getElementById('micStatusIndicator');
      const answerTextarea = document.getElementById('user_answer');

      if (isRecording) {
        if (recognition) recognition.stop();
        isRecording = false;
        micBtn.classList.remove('recording');
        micLabel.innerText = 'Jawab via Mic';
        statusIndicator.style.display = 'none';
        return;
      }

      recognition = new SpeechRecognition();
      recognition.lang = 'id-ID';
      recognition.continuous = true;
      recognition.interimResults = true;

      recognition.onstart = () => {
        isRecording = true;
        micBtn.classList.add('recording');
        micLabel.innerText = '⏹ Selesai Bicara';
        statusIndicator.style.display = 'flex';
      };

      recognition.onresult = (event) => {
        let transcript = '';
        for (let i = event.resultIndex; i < event.results.length; i++) {
          transcript += event.results[i][0].transcript;
        }
        if (event.results[event.results.length - 1].isFinal) {
          answerTextarea.value = (answerTextarea.value ? answerTextarea.value + ' ' : '') + transcript.trim();
        }
      };

      recognition.onerror = (event) => {
        console.warn('[MIC ERROR]', event.error);
        isRecording = false;
        micBtn.classList.remove('recording');
        micLabel.innerText = 'Jawab via Mic';
        statusIndicator.style.display = 'none';
      };

      recognition.onend = () => {
        isRecording = false;
        micBtn.classList.remove('recording');
        micLabel.innerText = 'Jawab via Mic';
        statusIndicator.style.display = 'none';
      };

      recognition.start();
    }

    // Defense 2-Minute Countdown Timer
    let defenseTimer = null;
    let defenseSeconds = 120;

    function startDefenseTimer() {
      clearInterval(defenseTimer);
      defenseSeconds = 120;
      const display = document.getElementById('defenseTimerDisplay');

      defenseTimer = setInterval(() => {
        if (defenseSeconds > 0) {
          defenseSeconds--;
          const m = Math.floor(defenseSeconds / 60);
          const s = defenseSeconds % 60;
          display.innerText = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
          if (defenseSeconds <= 30) {
            display.style.color = '#ef4444';
          }
        } else {
          clearInterval(defenseTimer);
          display.innerText = '00:00 (Waktu Habis)';
        }
      }, 1000);
    }
  </script>
</body>
</html>