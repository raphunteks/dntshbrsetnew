<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/png" href="/img/dentshubriset.png">
  <link rel="shortcut icon" type="image/png" href="/img/dentshubriset.png">
  <link rel="apple-touch-icon" href="/img/dentshubriset.png">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
</head>
<body>

  <div class="dashboard-layout">
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <aside class="dashboard-sidebar" id="dashboardSidebar">
      <div class="sidebar-header">
        <a href="/dashboard" class="brand-logo">
          <img src="/img/dentshubriset.png" alt="DENTSHUB RISET Logo" class="logo-icon-img">
          <span>DENTSHUB<span class="text-primary">RISET</span></span>
        </a>
      </div>

      <div class="sidebar-content">
        <!-- MODUL UTAMA -->
        <div>
          <div class="sidebar-nav-group-title">Navigasi Utama</div>
          <ul class="sidebar-nav-list">
            <li>
              <a href="/dashboard" class="sidebar-nav-link active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                <span>Dashboard</span>
              </a>
            </li>
            <li>
              <a href="/asisten" class="sidebar-nav-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2 2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"/><rect x="3" y="8" width="18" height="12" rx="4"/><circle cx="9" cy="14" r="1.5"/><circle cx="15" cy="14" r="1.5"/><path d="M9 18h6"/></svg>
                <span>AI Asisten Riset</span>
              </a>
            </li>
            <li>
              <a href="/penelitian" class="sidebar-nav-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                <span>Project Penelitian</span>
              </a>
            </li>
            <li>
              <a href="/skripsi" class="sidebar-nav-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                <span>Penyusunan BAB</span>
              </a>
            </li>
          </ul>
        </div>

        <!-- AI TOOLS -->
        <div>
          <div class="sidebar-nav-group-title">AI Research Tools</div>
          <ul class="sidebar-nav-list">
            <li>
              <a href="/ai-writer" class="sidebar-nav-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                <span>AI Writer Akademis</span>
              </a>
            </li>
            <li>
              <a href="/parafrase" class="sidebar-nav-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/><line x1="4" y1="4" x2="9" y2="9"/></svg>
                <span>Parafrase Skripsi</span>
              </a>
            </li>
            <li>
              <a href="/brainstorming" class="sidebar-nav-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/></svg>
                <span>Brainstorming Judul</span>
              </a>
            </li>
            <li>
              <a href="/novelty" class="sidebar-nav-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12h5l3 7 4-14 3 7h5"/></svg>
                <span>Temukan Novelty</span>
              </a>
            </li>
            <li>
              <a href="/revisi" class="sidebar-nav-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                <span>Lab Revisi Bimbingan</span>
              </a>
            </li>
            <li>
              <a href="/sidang" class="sidebar-nav-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <span>Simulasi Sidang</span>
              </a>
            </li>
          </ul>
        </div>

        <!-- AKUN & KREDIT -->
        <div>
          <div class="sidebar-nav-group-title">Sistem & Akun</div>
          <ul class="sidebar-nav-list">
            <li>
              <a href="/kredit" class="sidebar-nav-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><line x1="12" y1="6" x2="12" y2="8"/><line x1="12" y1="16" x2="12" y2="18"/></svg>
                <span>Saldo Kredit</span>
              </a>
            </li>
            <li>
              <a href="/billing" class="sidebar-nav-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                <span>Beli Paket</span>
              </a>
            </li>
            <li>
              <a href="/pengaturan" class="sidebar-nav-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                <span>Pengaturan Akun</span>
              </a>
            </li>
          </ul>
        </div>
      </div>

      <div class="sidebar-footer">
        <div class="user-mini-card">
          <div class="user-avatar">
            <%= (currentUser && currentUser.name) ? currentUser.name.charAt(0).toUpperCase() : 'P' %>
          </div>
          <div class="user-meta">
            <span class="user-name"><%= currentUser ? currentUser.name : 'Peneliti' %></span>
            <span class="user-role-badge"><%= currentUser ? currentUser.role.toUpperCase() : 'USER' %></span>
          </div>
        </div>
      </div>
    </aside>

    <div class="dashboard-main">
      <header class="dashboard-topbar">
        <div class="topbar-left">
          <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Buka Menu">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          </button>
          <div><h3 style="font-size: 1.15rem; margin: 0;">Ruang Kerja Riset</h3></div>
        </div>

        <div class="topbar-right">
          <a href="/kredit" class="credit-pill <%= creditBalance === 'UNLIMITED' ? 'unlimited' : '' %>" title="Saldo Kredit Aktif">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <% if (creditBalance === 'UNLIMITED') { %>
              <span class="unlimited-text"><span class="infinity-symbol">∞</span> UNLIMITED</span>
            <% } else { %>
              <span><%= creditBalance %> Kredit</span>
            <% } %>
          </a>

          <form action="/logout" method="POST" style="margin: 0;">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
            <button type="submit" class="btn btn-secondary btn-sm" title="Keluar dari sesi riset">Keluar</button>
          </form>
        </div>
      </header>

      <main class="dashboard-content">
        <div style="margin-bottom: 2rem;">
          <h2 style="font-size: 1.65rem; margin-bottom: 0.25rem;">
            Halo, <%= (currentUser && currentUser.name) ? currentUser.name : 'Rekan Peneliti' %> 👋
          </h2>
          <p style="color: var(--text-muted); margin: 0;">
            Akun Anda aktif (<%= currentUser ? currentUser.email : '' %>). Selamat datang di ruang kerja riset berintegritas tinggi.
          </p>
        </div>

        <!-- STATS GRID BERBASIS DATA REAL -->
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-header">
              <span class="stat-label">Total Project</span>
              <div class="stat-icon" style="background: var(--primary-100); color: var(--primary-600);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
              </div>
            </div>
            <div class="stat-value"><%= stats.totalProjects %></div>
            <div class="stat-footer"><%= stats.totalProjects > 0 ? `${stats.activeProjects} riset aktif berjalan` : 'Belum ada riset aktif' %></div>
          </div>

          <div class="stat-card">
            <div class="stat-header">
              <span class="stat-label">Bab Tersusun</span>
              <div class="stat-icon" style="background: #e0e7ff; color: #4338ca;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/></svg>
              </div>
            </div>
            <div class="stat-value"><%= stats.totalChapters %></div>
            <div class="stat-footer"><%= stats.totalChapters %> Bab tersimpan di sistem</div>
          </div>

          <div class="stat-card">
            <div class="stat-header">
              <span class="stat-label">Saldo Kredit Aktif</span>
              <div class="stat-icon" style="background: var(--accent-emerald-light); color: #047857;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </div>
            </div>
            <div class="stat-value">
              <% if (creditBalance === 'UNLIMITED') { %>
                <span class="badge-unlimited" style="font-size: 0.95rem; padding: 0.35rem 0.85rem;">UNLIMITED</span>
              <% } else { %>
                <%= creditBalance %>
              <% } %>
            </div>
            <div class="stat-footer"><%= creditBalance === 'UNLIMITED' ? 'Akses Riset Penuh Tanpa Batas' : 'Kredit siap digunakan untuk AI Tools' %></div>
          </div>

          <div class="stat-card">
            <div class="stat-header">
              <span class="stat-label">Status Peneliti</span>
              <div class="stat-icon" style="background: #dcfce7; color: #15803d;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
              </div>
            </div>
            <div class="stat-value" style="font-size: 1.35rem; color: #15803d;">Terverifikasi</div>
            <div class="stat-footer">Akun Akademik Aktif</div>
          </div>
        </div>

        <!-- QUICK SHORTCUTS -->
        <div style="margin-bottom: 2rem;">
          <h4 style="margin-bottom: 0.85rem;">Mulai Eksplorasi Riset</h4>
          <div class="shortcuts-grid">
            <a href="/brainstorming" class="shortcut-card">
              <div class="shortcut-icon">💡</div>
              <div>
                <strong style="display:block; font-size: 0.9rem;">Cari Ide & Judul</strong>
                <span style="font-size: 0.775rem; color: var(--text-muted);">Eksplorasi fenomena</span>
              </div>
            </a>

            <a href="/ai-writer" class="shortcut-card">
              <div class="shortcut-icon">✍️</div>
              <div>
                <strong style="display:block; font-size: 0.9rem;">AI Writer Skripsi</strong>
                <span style="font-size: 0.775rem; color: var(--text-muted);">Drafting bab terstruktur</span>
              </div>
            </a>

            <a href="/parafrase" class="shortcut-card">
              <div class="shortcut-icon">🔄</div>
              <div>
                <strong style="display:block; font-size: 0.9rem;">Parafrase Akademik</strong>
                <span style="font-size: 0.775rem; color: var(--text-muted);">Perhalus kalimat ilmiah</span>
              </div>
            </a>

            <a href="/penelitian" class="shortcut-card">
              <div class="shortcut-icon">📁</div>
              <div>
                <strong style="display:block; font-size: 0.9rem;">Kelola Project</strong>
                <span style="font-size: 0.775rem; color: var(--text-muted);">Kelola naskah skripsi</span>
              </div>
            </a>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Project Penelitian Anda</h3>
            <a href="/penelitian" class="btn btn-primary btn-sm">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              Kelola Semua Project
            </a>
          </div>

          <% if (recentProjects && recentProjects.length > 0) { %>
            <div class="table-responsive">
              <table class="table-custom">
                <thead>
                  <tr>
                    <th>Judul Penelitian</th>
                    <th>Institusi / Bidang</th>
                    <th>Jenis</th>
                    <th>Progres Bab</th>
                    <th>Aksi</th>
                  </tr>
                </thead>
                <tbody>
                  <% recentProjects.forEach(p => { %>
                    <tr>
                      <td>
                        <strong style="display:block; font-size: 0.95rem;">
                          <a href="/skripsi/<%= p.id %>"><%= p.title %></a>
                        </strong>
                        <span style="font-size: 0.775rem; color: var(--text-muted);">
                          Terakhir diubah: <%= new Date(p.updated_at).toLocaleDateString('id-ID') %>
                        </span>
                      </td>
                      <td><%= p.institution %> &bull; <span style="color: var(--text-muted);"><%= p.field %></span></td>
                      <td>
                        <span class="badge badge-primary" style="text-transform: uppercase;"><%= p.research_type %></span>
                      </td>
                      <td style="min-width: 140px;">
                        <div style="display: flex; justify-content: space-between; font-size: 0.75rem; margin-bottom: 0.25rem;">
                          <span><%= p.progress %>%</span>
                        </div>
                        <div class="progress-bar-container" style="height: 5px;">
                          <div class="progress-bar-fill" data-progress="<%= p.progress %>"></div>
                        </div>
                      </td>
                      <td>
                        <a href="/skripsi/<%= p.id %>" class="btn btn-primary btn-sm">
                          Buka Bab
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="card-body" style="text-align: center; padding: 3rem 1.5rem;">
              <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">📚</div>
              <h4 style="margin-bottom: 0.5rem;">Belum ada project penelitian yang dibuat</h4>
              <p style="max-width: 480px; margin: 0 auto 1.5rem; font-size: 0.9rem;">
                Mulai buat project skripsi, tesis, atau proposal penelitian Anda untuk mengaktifkan penyusunan bab dinamis dan pendampingan AI berintegritas.
              </p>
              <a href="/penelitian" class="btn btn-secondary btn-sm">
                Mulai Riset Sekarang
              </a>
            </div>
          <% } %>
        </div>
      </main>
    </div>
  </div>

  <script>
    const toggleBtn = document.getElementById('mobileMenuToggle');
    const sidebar = document.getElementById('dashboardSidebar');
    const overlay = document.getElementById('sidebarOverlay');

    function toggleSidebar() {
      sidebar.classList.toggle('show');
      overlay.classList.toggle('show');
    }

    if (toggleBtn) toggleBtn.addEventListener('click', toggleSidebar);
    if (overlay) overlay.addEventListener('click', toggleSidebar);

    document.querySelectorAll('.progress-bar-fill[data-progress]').forEach((el) => {
      el.style.width = (el.getAttribute('data-progress') || 0) + '%';
    });
  </script>
</body>
</html>