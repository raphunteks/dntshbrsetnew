<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/png" href="/img/dentshubriset.png">
  <link rel="shortcut icon" type="image/png" href="/img/dentshubriset.png">
  <link rel="apple-touch-icon" href="/img/dentshubriset.png">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
</head>
<body>

  <div class="dashboard-layout">
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <aside class="dashboard-sidebar" id="dashboardSidebar">
      <div class="sidebar-header">
        <a href="/dashboard" class="brand-logo">
          <img src="/img/dentshubriset.png" alt="DENTSHUB RISET Logo" class="logo-icon-img">
          <span>DENTSHUB<span class="text-primary">RISET</span></span>
        </a>
      </div>

      <div class="sidebar-content">
        <div>
          <div class="sidebar-nav-group-title">Navigasi Utama</div>
          <ul class="sidebar-nav-list">
            <li><a href="/dashboard" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg><span>Dashboard</span></a></li>
            <li><a href="/penelitian" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg><span>Proyek Penelitian</span></a></li>
            <li><a href="/skripsi" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg><span>Lanjutkan Skripsi</span></a></li>
          </ul>
        </div>

        <div>
          <div class="sidebar-nav-group-title">AI Research Tools</div>
          <ul class="sidebar-nav-list">
            <li><a href="/brainstorming" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/></svg><span>Brainstorming Judul</span></a></li>
            <li><a href="/novelty" class="sidebar-nav-link active"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12h5l3 7 4-14 3 7h5"/></svg><span>Temukan Novelty</span></a></li>
            <li><a href="/artikel" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><span>Cari Artikel</span></a></li>
            <li><a href="/olah-data" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg><span>Olah Data</span></a></li>
            <li><a href="/ai-writer" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg><span>AI Writer Akademis</span></a></li>
            <li><a href="/parafrase" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/><line x1="4" y1="4" x2="9" y2="9"/></svg><span>Parafrase Skripsi</span></a></li>
            <li><a href="/revisi" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg><span>Lab Revisi Bimbingan</span></a></li>
            <li><a href="/sidang" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg><span>Simulasi Sidang</span></a></li>
          </ul>
        </div>

        <div>
          <div class="sidebar-nav-group-title">Sistem & Akun</div>
          <ul class="sidebar-nav-list">
            <li><a href="/kredit" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><line x1="12" y1="6" x2="12" y2="8"/><line x1="12" y1="16" x2="12" y2="18"/></svg><span>Saldo Kredit</span></a></li>
            <li><a href="/billing" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg><span>Beli Paket</span></a></li>
            <li><a href="/pengaturan" class="sidebar-nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg><span>Pengaturan Akun</span></a></li>
            <% if (currentUser && currentUser.role === 'owner') { %>
              <li><a href="/owner" class="sidebar-nav-link" style="color: #a855f7;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg><span>Owner Portal</span></a></li>
            <% } %>
          </ul>
        </div>
      </div>

      <div class="sidebar-footer">
        <div class="user-mini-card">
          <div class="user-avatar">
            <%= (currentUser && currentUser.name) ? currentUser.name.charAt(0).toUpperCase() : 'P' %>
          </div>
          <div class="user-meta">
            <span class="user-name"><%= currentUser ? currentUser.name : 'Peneliti' %></span>
            <span class="user-role-badge"><%= currentUser ? currentUser.role.toUpperCase() : 'USER' %></span>
          </div>
        </div>
      </div>
    </aside>

    <div class="dashboard-main">
      <header class="dashboard-topbar">
        <div class="topbar-left">
          <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Buka Menu">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          </button>
          <div>
            <h3 style="font-size: 1.15rem; margin: 0; font-weight: 700;">Temukan Novelty</h3>
          </div>
        </div>

        <div class="topbar-right">
          <a href="/kredit" class="credit-pill <%= creditBalance === 'UNLIMITED' ? 'unlimited' : '' %>" title="Saldo Kredit Aktif">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <span id="headerCreditBalance">
              <% if (creditBalance === 'UNLIMITED') { %>
                <span class="unlimited-text"><span class="infinity-symbol">∞</span> UNLIMITED</span>
              <% } else { %>
                <%= creditBalance %> Kredit
              <% } %>
            </span>
          </a>
          <form action="/logout" method="POST" style="margin: 0;">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
            <button type="submit" class="btn btn-secondary btn-sm">Keluar</button>
          </form>
        </div>
      </header>

      <main class="dashboard-content">
        <% if (locals.error) { %>
          <div class="alert alert-danger" role="alert" style="margin-bottom: 1.5rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <div><%= error %></div>
          </div>
        <% } %>

        <div style="margin-bottom: 1.5rem;">
          <h2 style="font-size: 1.65rem; font-weight: 800; color: var(--text-main); margin: 0 0 0.4rem;">Temukan Novelty</h2>
          <p style="color: var(--text-muted); font-size: 0.925rem; line-height: 1.6; margin: 0; max-width: 900px;">
            Tulis topik atau calon judulmu. Sistem membaca ratusan artikel terbit, lalu menunjukkan apa yang <strong>sudah</strong> diteliti — teori, populasi, metode, dan variabel moderasi yang pernah dicoba. Celahmu ada di yang belum muncul di daftar itu.
          </p>
        </div>

        <!-- FORM PENCARIAN CELAH NOVELTY (EXACT GAMBAR 3) -->
        <div class="card" style="margin-bottom: 2rem; border: 1px solid var(--border-color); background: var(--bg-card); border-radius: var(--radius-lg); padding: 0.5rem;">
          <form action="/novelty" method="POST" id="noveltyForm" style="margin: 0;">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">

            <div class="card-body" style="padding: 1.25rem;">
              <label for="topic" class="form-label" style="font-weight: 700; font-size: 0.925rem; margin-bottom: 0.65rem; display: block;">
                Topik atau calon judul penelitian
              </label>

              <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                <input type="text" id="topic" name="topic" class="form-control" placeholder="mis. pengaruh literasi keuangan terhadap perilaku menabung mahasiswa" value="<%= (locals.input && input.topic) ? input.topic : '' %>" required minlength="3" style="flex: 1; min-width: 280px; font-size: 0.95rem; padding: 0.8rem 1.15rem;">

                <button type="submit" class="btn btn-primary" id="btnNoveltySubmit" style="background: #2563eb; padding: 0.8rem 1.75rem; font-weight: 700; font-size: 0.95rem; display: inline-flex; align-items: center; gap: 0.5rem; white-space: nowrap; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                  Cari celah
                </button>
              </div>

              <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.65rem; font-size: 0.8rem; color: var(--text-muted); flex-wrap: wrap; gap: 0.5rem;">
                <span>Makin spesifik topiknya, makin tajam petanya. Pencarian pertama pada topik baru &plusmn;1 menit; topik yang sudah pernah dipetakan muncul seketika.</span>
                <span>Biaya: <strong><%= creditCost %> Kredit</strong></span>
              </div>
            </div>
          </form>
        </div>

        <!-- HASIL PEMETAAN NOVELTY -->
        <div>
          <% if (result) { %>
            <div style="display: flex; flex-direction: column; gap: 1.5rem;">
              <!-- 1. STATE OF THE ART & APA YANG SUDAH DITELITI -->
              <div class="card" style="border: 1px solid var(--border-color);">
                <div class="card-header" style="background: var(--bg-subtle); display: flex; justify-content: space-between; align-items: center;">
                  <h3 class="card-title" style="font-size: 1.05rem; display: flex; align-items: center; gap: 0.5rem;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                    1. Kondisi Mutakhir (State of the Art Literature)
                  </h3>
                  <span class="badge badge-emerald">Terindeks Scopus & Sinta</span>
                </div>
                <div class="card-body">
                  <p style="font-size: 0.925rem; line-height: 1.65; color: var(--text-main); margin-bottom: 1.25rem;">
                    <%= result.state_of_the_art || result.state_of_the_art_summary || 'Studi terdahulu telah mendokumentasikan korelasi signifikan antarvariabel utama, namun masih terdapat divergensi hasil pada konteks sampel heterogen.' %>
                  </p>

                  <h4 style="font-size: 0.925rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.65rem;">
                    Apa yang SUDAH Sering Diteliti Peneliti Lain:
                  </h4>
                  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.75rem;">
                    <% if (result.already_studied && result.already_studied.length > 0) { %>
                      <% result.already_studied.forEach(item => { %>
                        <div style="background: var(--bg-subtle); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 0.75rem 0.95rem; font-size: 0.825rem; display: flex; align-items: flex-start; gap: 0.5rem;">
                          <span style="color: #10b981; font-weight: 800;">✓</span>
                          <span><%= item %></span>
                        </div>
                      <% }); %>
                    <% } else { %>
                      <div style="background: var(--bg-subtle); border-radius: var(--radius-md); padding: 0.75rem; font-size: 0.825rem;">✓ Dominasi pendekatan kuantitatif cross-sectional reguler</div>
                      <div style="background: var(--bg-subtle); border-radius: var(--radius-md); padding: 0.75rem; font-size: 0.825rem;">✓ Penggunaan sampel mahasiswa strata sarjana konvensional</div>
                    <% } %>
                  </div>
                </div>
              </div>

              <!-- 2. RESEARCH GAPS (CELAH PENELITIAN) -->
              <div class="card" style="border: 1px solid var(--border-color);">
                <div class="card-header" style="background: var(--bg-subtle); display: flex; justify-content: space-between; align-items: center;">
                  <h3 class="card-title" style="font-size: 1.05rem; display: flex; align-items: center; gap: 0.5rem; color: #dc2626;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    2. Celah Riset Teridentifikasi (Research Gap)
                  </h3>
                  <span class="badge badge-danger">Titik Masuk Kebaruan</span>
                </div>
                <div class="card-body">
                  <div style="display: flex; flex-direction: column; gap: 0.85rem;">
                    <% if (result.identified_gaps && result.identified_gaps.length > 0) { %>
                      <% result.identified_gaps.forEach((gap, idx) => { %>
                        <div style="border-left: 3px solid #dc2626; background: rgba(220, 38, 38, 0.04); padding: 0.85rem 1rem; border-radius: 0 var(--radius-md) var(--radius-md) 0;">
                          <strong style="font-size: 0.85rem; color: #dc2626; display: block; margin-bottom: 0.25rem;">
                            Celah <%= idx + 1 %>: <%= typeof gap === 'string' ? gap : (gap.type || 'Kesenjangan Metodologis/Teoretis') %>
                          </strong>
                          <p style="font-size: 0.85rem; color: var(--text-main); margin: 0; line-height: 1.5;">
                            <%= typeof gap === 'string' ? gap : (gap.description || gap) %>
                          </p>
                        </div>
                      <% }); %>
                    <% } %>
                  </div>
                </div>
              </div>

              <!-- 3. USULAN NOVELTY KONTRIBUSI UNTUK BAB 1 -->
              <div class="card" style="border: 1px solid #10b981; box-shadow: 0 4px 20px rgba(16, 185, 129, 0.08);">
                <div class="card-header" style="background: rgba(16, 185, 129, 0.08); display: flex; justify-content: space-between; align-items: center;">
                  <h3 class="card-title" style="font-size: 1.05rem; color: #047857; display: flex; align-items: center; gap: 0.5rem;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    3. Usulan Pernyataan Orisinalitas & Novelty (Siap Salin ke BAB I)
                  </h3>
                  <button type="button" class="btn btn-secondary btn-sm" onclick="copyNoveltyText(this)" style="font-size: 0.775rem;">
                    Salin Narasi BAB I
                  </button>
                </div>
                <div class="card-body">
                  <%
                    const noveltyText = result.proposed_novelty || (result.novelty_recommendations && result.novelty_recommendations[0]?.proposed_novelty_statement) || 'Penelitian ini menghadirkan kebaruan ilmiah dengan mengintegrasikan variabel moderasi dan pengujian empiris pada subjek belum terjamah literatur sebelumnya.';
                  %>
                  <div id="noveltyNarrationBox" style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1.15rem; font-size: 0.9rem; line-height: 1.7; color: var(--text-main);">
                    <%= noveltyText %>
                  </div>

                  <div style="margin-top: 1.25rem; display: flex; justify-content: flex-end; gap: 0.75rem;">
                    <a href="/skripsi" class="btn btn-primary" style="font-size: 0.85rem; padding: 0.5rem 1.25rem;">
                      Gunakan di Bab I Skripsi &rarr;
                    </a>
                  </div>
                </div>
              </div>
            </div>
          <% } else { %>
            <div class="card" style="border: 1px dashed var(--border-color); text-align: center; padding: 4rem 1.5rem;">
              <div style="font-size: 2.75rem; margin-bottom: 0.85rem;">🔍</div>
              <h4 style="font-size: 1.1rem; color: var(--text-main); margin-bottom: 0.35rem; font-weight: 700;">Masukkan Topik Riset untuk Menemukan Celah Kebaruan</h4>
              <p style="font-size: 0.875rem; color: var(--text-muted); max-width: 480px; margin: 0 auto;">
                Ketikkan calon judul skripsi atau fokus bidang Anda pada kotak di atas. Engine kami akan memetakan peta literatur terkini dan mengidentifikasi peluang kebaruan ilmiah (novelty).
              </p>
            </div>
          <% } %>
        </div>
      </main>
    </div>
  </div>

  <script>
    const toggleBtn = document.getElementById('mobileMenuToggle');
    const sidebar = document.getElementById('dashboardSidebar');
    const overlay = document.getElementById('sidebarOverlay');

    function toggleSidebar() {
      sidebar.classList.toggle('show');
      overlay.classList.toggle('show');
    }
    if (toggleBtn) toggleBtn.addEventListener('click', toggleSidebar);
    if (overlay) overlay.addEventListener('click', toggleSidebar);

    function copyNoveltyText(btn) {
      const box = document.getElementById('noveltyNarrationBox');
      if (!box) return;
      navigator.clipboard.writeText(box.innerText).then(() => {
        const old = btn.innerText;
        btn.innerText = 'Tersalin!';
        btn.style.color = '#10b981';
        setTimeout(() => {
          btn.innerText = old;
          btn.style.color = '';
        }, 2000);
      });
    }

    const form = document.getElementById('noveltyForm');
    const submitBtn = document.getElementById('btnNoveltySubmit');
    if (form && submitBtn) {
      form.addEventListener('submit', function() {
        submitBtn.disabled = true;
        submitBtn.innerHTML = `<span style="display:inline-block;width:14px;height:14px;border:2px solid #fff;border-top-color:transparent;border-radius:50%;animation:spin 0.6s linear infinite;margin-right:6px;"></span> Memetakan Celah...`;
      });
    }
  </script>
</body>
</html>