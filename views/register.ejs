<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Daftar Akun Peneliti - DENTSHUB RISET</title>
  <link rel="icon" type="image/png" href="/img/dentshubriset.png">
  <link rel="shortcut icon" type="image/png" href="/img/dentshubriset.png">
  <link rel="apple-touch-icon" href="/img/dentshubriset.png">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

  <div class="auth-wrapper">
    <div class="auth-card">
      <div class="auth-header">
        <a href="/" style="display: inline-block;">
          <img src="/img/dentshubriset.png" alt="DENTSHUB RISET Logo" class="logo-icon-img auth-logo">
        </a>
        <h1 class="auth-title">Buat Akun Peneliti</h1>
        <p class="auth-subtitle">Dapatkan bonus 100 kredit awal untuk memulai riset Anda</p>
      </div>

      <% if (locals.error) { %>
        <div class="alert alert-danger" role="alert">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <div><%= error %></div>
        </div>
      <% } %>

      <form action="/register" method="POST">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
        <div class="form-group">
          <label for="name" class="form-label">Nama Lengkap & Gelar</label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            class="form-control" 
            placeholder="Contoh: Ahmad Fauzan, S.Ked" 
            required 
            minlength="2"
            maxlength="100"
            value="<%= locals.name || '' %>"
          >
        </div>

        <div class="form-group">
          <label for="email" class="form-label">Alamat Email Akademik / Pribadi</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            class="form-control" 
            placeholder="nama@kampus.ac.id" 
            required 
            autocomplete="email"
            value="<%= locals.email || '' %>"
          >
        </div>

        <div class="form-group">
          <label for="password" class="form-label">Kata Sandi (Minimal 8 Karakter)</label>
          <div class="input-icon-wrapper">
            <input 
              type="password" 
              id="password" 
              name="password" 
              class="form-control" 
              placeholder="••••••••" 
              required 
              minlength="8"
              autocomplete="new-password"
            >
            <button type="button" class="input-icon-btn" id="togglePasswordBtn" aria-label="Lihat kata sandi">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>

        <p style="font-size: 0.775rem; color: var(--text-muted); margin-top: 0.5rem; line-height: 1.4;">
          Dengan mendaftar, Anda menyetujui prinsip integritas akademik, larangan fabrikasi data ilmiah, dan ketentuan layanan DENTSHUB RISET.
        </p>

        <button type="submit" class="btn btn-primary btn-block" style="margin-top: 1.25rem; padding: 0.75rem;">
          Daftar & Klaim 100 Kredit
        </button>
      </form>

      <div class="auth-footer">
        Sudah memiliki akun? <a href="/login" class="font-semibold text-primary">Masuk di sini</a>
      </div>
    </div>
  </div>

  <script>
    const toggleBtn = document.getElementById('togglePasswordBtn');
    const passwordInput = document.getElementById('password');

    if (toggleBtn && passwordInput) {
      toggleBtn.addEventListener('click', () => {
        const isPassword = passwordInput.type === 'password';
        passwordInput.type = isPassword ? 'text' : 'password';
        toggleBtn.style.color = isPassword ? 'var(--primary-600)' : 'var(--text-muted)';
      });
    }
  </script>
</body>
</html>